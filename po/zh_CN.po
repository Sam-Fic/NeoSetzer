msgid "additional math fonts from AMS."
msgstr "AMS 的附加数学字体。"

#: data/resources/latexdb/packages/general.xml:3
msgid "mathematics package from AMS."
msgstr "AMS 的数学宏包。"

#: data/resources/latexdb/packages/general.xml:4
msgid "mathematical symbols from AMS."
msgstr "AMS 的数学符号宏包。"

#: data/resources/latexdb/packages/general.xml:5
msgid "math theorems setting package from AMS."
