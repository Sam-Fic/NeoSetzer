msgstr "PhiTeX konnte nicht aktualisiert werden: Der Befehl wurde nicht ausgeführt."

#: setzer/dialogs/preferences/pages/page_build_system.py:477
#, python-brace-format
msgid "PhiTeX could not be upgraded: {message}"
msgstr "PhiTeX konnte nicht aktualisiert werden: {message}"

#: setzer/dialogs/preferences/pages/page_build_system.py:534
msgid "Build system"
msgstr "Build-System"

#: setzer/dialogs/preferences/pages/page_build_system.py:538
msgid "LaTeX interpreter"
msgstr "LaTeX-Interpreter"

#: setzer/dialogs/preferences/pages/page_build_system.py:552
msgid ""
"No LaTeX interpreter found. To install interpreters in Flatpak, open a terminal and run the following command:\n"
"flatpak install org.freedesktop.Sdk.Extension.texlive"
msgstr ""
"Kein LaTeX-Interpreter gefunden. Um Interpreter in Flatpak zu installieren, öffnen Sie ein Terminal und führen Sie folgenden Befehl aus:\n"
"flatpak install org.freedesktop.Sdk.Extension.texlive"

#: setzer/dialogs/preferences/pages/page_build_system.py:555
msgid "No LaTeX interpreter found. For instructions on installing LaTeX see <a href=\"https://en.wikibooks.org/wiki/LaTeX/Installation\">https://en.wikibooks.org/wiki/LaTeX/Installation</a>"
msgstr "Kein LaTeX-Interpreter gefunden. Informationen zur Installation von LaTeX finden Sie auf <a href=\"https://en.wikibooks.org/wiki/LaTeX/Installation\">https://en.wikibooks.org/wiki/LaTeX/Installation</a>"

#: setzer/dialogs/preferences/pages/page_build_system.py:556
msgid "Please note: the Tectonic backend uses only the V1 command-line interface. Tectonic.toml configuration files are ignored. For custom build configuration, switch to another interpreter (see the <a href=\"https://tectonic-typesetting.github.io/tectonic/\">Tectonic documentation</a>)."
msgstr "Hinweis: Das Tectonic-Backend verwendet nur die V1-Befehlszeilenschnittstelle. Tectonic.toml-Konfigurationsdateien werden ignoriert. Wechseln Sie für eine benutzerdefinierte Erstellungskonfiguration zu einer anderen Engine (siehe <a href=\"https://tectonic-typesetting.github.io/tectonic/\">Tectonic-Dokumentation</a>)."

#: setzer/dialogs/preferences/pages/page_build_system.py:557
msgid "PhiTeX builds once to a fixpoint (BibTeX, biber and makeindex included), so the latexmk options below do not apply. Its PDF is byte-identical to pdfLaTeX’s, but LuaLaTeX is not supported yet. Editing stays instant only while a PhiTeX session is running; without one, use another interpreter for the fastest full rebuilds."
msgstr "PhiTeX erstellt einmal bis zum Fixpunkt (inklusive BibTeX, biber und makeindex), daher gelten die latexmk-Optionen unten nicht. Sein PDF ist bytegenau identisch mit dem von pdfLaTeX, LuaLaTeX wird aber noch nicht unterstützt. Sofortige Bearbeitung funktioniert nur, während eine PhiTeX-Sitzung läuft; ohne Sitzung wählen Sie für die schnellste vollständige Neuerstellung einen anderen Interpreter."

#: setzer/dialogs/preferences/pages/page_build_system.py:560
#: setzer/dialogs/project_build_configuration_viewgtk.py:225
msgid "Interpreter"
msgstr "LaTeX-Interpreter"

#: setzer/dialogs/preferences/pages/page_build_system.py:567
msgid "Install PhiTeX"
msgstr "PhiTeX installieren"

#: setzer/dialogs/preferences/pages/page_build_system.py:568
msgid "Not found on this machine. Copy the instructions and hand them to an AI agent — it will fetch and verify the release for your platform."
msgstr "Auf diesem Rechner nicht gefunden. Kopieren Sie die Anleitung und geben Sie sie an einen KI-Agenten weiter — er lädt die für Ihre Plattform passende Veröffentlichung herunter und prüft sie."

#: setzer/dialogs/preferences/pages/page_build_system.py:572
msgid "Copy the installation instructions to the clipboard"
msgstr "Installationsanweisung in die Zwischenablage kopieren"

#: setzer/dialogs/preferences/pages/page_build_system.py:582
msgid "PhiTeX"
msgstr "PhiTeX"

#: setzer/dialogs/preferences/pages/page_build_system.py:588
msgid "Version"
msgstr "Version"

#: setzer/dialogs/preferences/pages/page_build_system.py:592
msgid "Let PhiTeX check for updates"
msgstr "PhiTeX nach Aktualisierungen suchen lassen"

#: setzer/dialogs/preferences/pages/page_build_system.py:593
msgid "PhiTeX checks at most once a day, on its own, from its own binary. NeoSetzer never downloads or queries anything for it."
msgstr "PhiTeX prüft höchstens einmal täglich selbst, mit seiner eigenen Binärdatei. NeoSetzer lädt dafür nichts herunter und fragt nichts ab."

#: setzer/dialogs/preferences/pages/page_build_system.py:597
msgid "Upgrade to the latest release"
msgstr "Auf die neueste Veröffentlichung aktualisieren"

#: setzer/dialogs/preferences/pages/page_build_system.py:598
msgid "PhiTeX downloads and verifies its own release, then replaces its binary by rename. NeoSetzer only runs the command."
msgstr "PhiTeX lädt seine Veröffentlichung selbst herunter, prüft sie und ersetzt dann seine Binärdatei per Umbenennen. NeoSetzer führt nur den Befehl aus."

#: setzer/dialogs/preferences/pages/page_build_system.py:605
msgid "Running PhiTeX sessions are ended after an upgrade, so the next build starts on the new version."
msgstr "Laufende PhiTeX-Sitzungen werden nach einer Aktualisierung beendet, damit die nächste Erstellung die neue Fassung verwendet."

#: setzer/dialogs/preferences/pages/page_build_system.py:612
msgid "Automatically remove helper files (.log, .dvi, …) after building .pdf."
msgstr "Hilfsdateien (.log, .dvi, …) nach der .pdf-Erstellung automatisch entfernen."

#: setzer/dialogs/preferences/pages/page_build_system.py:620
msgid "Keep a PhiTeX session running"
msgstr "PhiTeX-Sitzung dauerhaft laufen lassen"

#: setzer/dialogs/preferences/pages/page_build_system.py:621
msgid "Rebuild only what the edit affects by reusing one running PhiTeX process per document. Turning this off re-starts PhiTeX for every build, which recompiles the whole document each time."
msgstr "Es wird nur das neu erstellt, was die Änderung betrifft, indem je Dokument ein laufender PhiTeX-Prozess weiterverwendet wird. Ohne diese Option wird PhiTeX bei jedem Erstellen neu gestartet und jedes Mal das gesamte Dokument neu kompiliert."

#: setzer/dialogs/preferences/pages/page_build_system.py:630
msgid "Precise SyncTeX in Background"
msgstr "Präzises SyncTeX im Hintergrund"

#: setzer/dialogs/preferences/pages/page_build_system.py:631
msgid "While PhiTeX live preview is active, regenerate SyncTeX with the native TeX engine in the background for accurate jumping. Jumping is briefly unavailable while it updates."
msgstr "Solange die PhiTeX-Live-Vorschau aktiv ist, wird SyncTeX im Hintergrund mit der nativen TeX-Engine neu erzeugt, um präzise Sprünge zu ermöglichen. Während der Aktualisierung ist das Springen kurzzeitig nicht verfügbar."

#: setzer/dialogs/preferences/pages/page_build_system.py:639
msgid "Output chain"
msgstr "Ausgabe-Kette"

#: setzer/dialogs/preferences/pages/page_build_system.py:640
msgid "PDF via PostScript runs latex → dvips → ps2pdf. Needed by PSTricks/psfrag; your interpreter choice is ignored on this route."
msgstr "PDF via PostScript führt latex → dvips → ps2pdf aus. Benötigt von PSTricks/psfrag; Ihre Interpreterwahl wird auf dieser Route ignoriert."

#: setzer/dialogs/preferences/pages/page_build_system.py:642
msgid "Direct PDF"
msgstr "Direktes PDF"

#: setzer/dialogs/preferences/pages/page_build_system.py:643
msgid "PDF via PostScript (DVI → dvips → ps2pdf)"
msgstr "PDF via PostScript (DVI → dvips → ps2pdf)"

#: setzer/dialogs/preferences/pages/page_build_system.py:649
msgid "Generate SyncTeX for preview sync"
msgstr "SyncTeX für Vorschau-Synchronisation erzeugen"

#: setzer/dialogs/preferences/pages/page_build_system.py:650
msgid "Enables forward/reverse sync between editor and PDF preview. Disabling makes builds slightly faster."
msgstr "Aktiviert Vorwärts-/Rückwärts-Synchronisation zwischen Editor und PDF-Vorschau. Deaktivieren beschleunigt Build-Vorgänge geringfügig."

#: setzer/dialogs/preferences/pages/page_build_system.py:654
msgid "Elapsed-time counter on the build button"
msgstr "Zeitzähler am Erstellungsknopf"

#: setzer/dialogs/preferences/pages/page_build_system.py:655
msgid "The counter only moves in whole seconds, so a build that finishes sooner never shows a number worth reading."
msgstr "Der Zähler läuft nur in vollen Sekunden — eine Erstellung, die früher endet, zeigt nie eine Zahl, die etwas taugt."

#: setzer/dialogs/preferences/pages/page_build_system.py:657
msgid "Show once the build passes a second"
msgstr "Anzeigen, sobald die Erstellung eine Sekunde überschreitet"

#: setzer/dialogs/preferences/pages/page_build_system.py:658
msgid "Always show"
msgstr "Immer anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:659
msgid "Never show"
msgstr "Nie anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:665
msgid "Auto build"
msgstr "Automatische Erstellung"

#: setzer/dialogs/preferences/pages/page_build_system.py:669
msgid "Automatically build and save after changes"
msgstr "Nach Änderungen automatisch erstellen und speichern"

#: setzer/dialogs/preferences/pages/page_build_system.py:670
msgid "When you stop typing, the document is saved and rebuilt after a short delay."
msgstr "Wenn Sie das Tippen beenden, wird das Dokument gespeichert und nach kurzer Verzögerung neu erstellt."

#: setzer/dialogs/preferences/pages/page_build_system.py:674
msgid "Delay (seconds)"
msgstr "Verzögerung (Sekunden)"

#: setzer/dialogs/preferences/pages/page_build_system.py:676
msgid "Shorter delays update the preview faster but use more CPU while typing."
msgstr "Kürzere Verzögerungen aktualisieren die Vorschau schneller, verbrauchen beim Tippen jedoch mehr CPU-Leistung."

#: setzer/dialogs/preferences/pages/page_build_system.py:687
msgid "Pop up build log on auto-build errors"
msgstr "Bei Fehlern beim automatischen Erstellen das Protokoll anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:689
msgid "When auto-build is on, automatically show the build log when errors occur. Disable to avoid interruptions while typing."
msgstr "Wenn die automatische Erstellung aktiv ist, wird bei Fehlern automatisch das Protokoll angezeigt. Deaktivieren, um Unterbrechungen beim Tippen zu vermeiden."

#: setzer/dialogs/preferences/pages/page_build_system.py:694
msgid "Automatically show build log"
msgstr "Erstellungsprotokoll automatisch anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:698
#: setzer/document/statusbar/statusbar_viewgtk.py:81
msgid "Show build log"
msgstr "Erstellungsprotokoll anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:700
msgid ".. only when errors occurred."
msgstr ".. nur wenn Fehler auftreten."

#: setzer/dialogs/preferences/pages/page_build_system.py:701
msgid ".. on errors and warnings."
msgstr ".. bei Fehlern und Warnungen."

#: setzer/dialogs/preferences/pages/page_build_system.py:702
msgid ".. on errors, warnings and badboxes."
msgstr ".. bei Fehlern, Warnungen und Badboxen."

#: setzer/dialogs/preferences/pages/page_build_system.py:703
msgid ".. never."
msgstr ".. nie."

#: setzer/dialogs/preferences/pages/page_build_system.py:709
msgid "Embedded system commands"
msgstr "Systembefehle einbetten"

#: setzer/dialogs/preferences/pages/page_build_system.py:726
msgid "Warning: enable this only if you have to. It can cause security problems when building files from untrusted sources."
msgstr "Vorsicht: nur aktivieren, wenn es sein muss. Es kann zu Sicherheitsproblemen mit Dateien aus nicht vertrauenswürdiger Quelle kommen."

#: setzer/dialogs/preferences/pages/page_build_system.py:734
msgid "System commands"
msgstr "Systembefehle"

#: setzer/dialogs/preferences/pages/page_build_system.py:736
msgid "Disable"
msgstr "Deaktiviert"

#: setzer/dialogs/preferences/pages/page_build_system.py:737
msgid "Enable restricted \\write18{SHELL COMMAND}"
msgstr "Eingeschränkt aktiviertes \\write18{SHELL COMMAND}"

#: setzer/dialogs/preferences/pages/page_build_system.py:738
msgid "Fully enable \\write18{SHELL COMMAND}"
msgstr "Vollständig aktiviertes \\write18{SHELL COMMAND}"

#: setzer/dialogs/preferences/pages/page_build_system.py:745
msgid "Personal TeX tree"
msgstr "Persönlicher TeX-Baum"

#: setzer/dialogs/preferences/pages/page_build_system.py:746
msgid "Directory with your own packages, classes and bibliography styles (kpathsea TEXMFHOME). Applied to every build; leave empty to use your environment or the TeX Live default (~/texmf)."
msgstr "Verzeichnis mit Ihren eigenen Paketen, Klassen und Bibliographiestilen (kpathsea TEXMFHOME). Auf jeden Build angewendet; leer lassen, um Ihre Umgebung oder den TeX-Live-Standard (~/texmf) zu verwenden."

#: setzer/dialogs/preferences/pages/page_build_system.py:750
