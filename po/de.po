msgstr "LaTeX-Dokumente bleiben typischerweise innerhalb von 80 Spalten."

#: setzer/dialogs/preferences/pages/page_editor.py:925
msgid "Line wrapping"
msgstr "Zeilenumbruch"

#: setzer/dialogs/preferences/pages/page_editor.py:929
