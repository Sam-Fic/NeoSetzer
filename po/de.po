msgid ""
"<b>Scrartcl:</b>  KOMA-Script replacement for the article class. Adds many "
"customizations and sensible defaults."
msgstr ""
"<b>Scrartcl:</b> KOMA-Script-Ersatz für die Dokumentklasse article. Bietet "
"viele Anpassungen und sinnvolle Vorgaben."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:188
msgid "<b>Scrreprt:</b>  KOMA-Script replacement for the report class."
msgstr "<b>Scrreprt:</b> KOMA-Script-Ersatz für die Dokumentklasse report."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:189
msgid "<b>Scrbook:</b>  KOMA-Script replacement for the book class."
msgstr "<b>Scrbook:</b> KOMA-Script-Ersatz für die Dokumentklasse book."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:190
msgid ""
"<b>Scrlttr2:</b>  KOMA-Script letter class with advanced features for "
"address, date, and subject layout."
msgstr ""
"<b>Scrlttr2:</b> KOMA-Script-Briefklasse mit erweiterten Funktionen für die "
"Gestaltung von Adresse, Datum und Betreff."

