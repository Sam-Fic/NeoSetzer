msgstr "Weitere Sprachen lassen sich über hunspell-/aspell-Pakete installieren."

#: setzer/dialogs/preferences/pages/page_editor.py:1031
msgid "Manage words"
msgstr "Wörter verwalten"

#: setzer/dialogs/preferences/pages/page_editor.py:1033
