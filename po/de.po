msgstr "nicht installiert"

#: setzer/dialogs/preferences/pages/page_build_system.py:388
msgid "Remove this custom tool"
msgstr "Dieses benutzerdefinierte Werkzeug entfernen"

#: setzer/dialogs/preferences/pages/page_build_system.py:406
msgid "No trusted directories yet"
msgstr "Noch keine vertrauenswürdigen Verzeichnisse"

#: setzer/dialogs/preferences/pages/page_build_system.py:407
