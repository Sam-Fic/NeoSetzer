msgstr "Die Umgebung hervorheben, die zum \\begin- oder \\end-Befehl neben dem Cursor passt."

#: setzer/dialogs/preferences/pages/page_editor.py:1011
msgid "Spell checking"
msgstr "Rechtschreibprüfung"

#: setzer/dialogs/preferences/pages/page_editor.py:1015
msgid "Check spelling as you type"
msgstr "Rechtschreibung beim Tippen prüfen"

