#: setzer/dialogs/preferences/pages/page_shortcuts.py:722
msgid "Reset to defaults"
msgstr "Auf Standardwerte zurücksetzen"

#: setzer/dialogs/preferences/pages/page_appearance.py:909
msgid "Add custom tool"
msgstr "Benutzerdefiniertes Werkzeug hinzufügen"

#: setzer/dialogs/preferences/pages/page_appearance.py:939
msgid "Tool name (unique)"
msgstr "Werkzeugname (eindeutig)"

#: setzer/dialogs/preferences/pages/page_appearance.py:943
msgid "Executable (such as aider)"
msgstr "Programm (etwa aider)"

#: setzer/dialogs/preferences/pages/page_appearance.py:947
msgid "Headed command template"
msgstr "Befehlskopfvorlage"

#: setzer/dialogs/preferences/pages/page_appearance.py:949
#, python-brace-format
msgid "Space-separated args. Use {prompt} / {file} / {cwd} as placeholders. Example: aider --message {prompt} --no-auto-commits. If left blank or without {prompt}, the prompt is copied to clipboard."
msgstr "Leerzeichengetrennte Argumente. Verwenden Sie {prompt} / {file} / {cwd} als Platzhalter. Beispiel: aider --message {prompt} --no-auto-commits. Wenn Sie das Feld leer lassen oder ohne {prompt}, wird die Eingabeaufforderung in die Zwischenablage kopiert."

#: setzer/dialogs/preferences/pages/page_build_system.py:166
msgid "PhiTeX rebuilds as you type, which needs each edit written to disk first — auto build is always on for it."
msgstr "PhiTeX erstellt beim Schreiben neu, dazu muss jede Änderung zuerst auf die Platte geschrieben werden — das automatische Erstellen ist hier immer aktiv."

#: setzer/dialogs/preferences/pages/page_build_system.py:168
msgid "PhiTeX uses a short fixed delay: an incremental rebuild takes about 20 ms, so a longer wait only delays the preview."
msgstr "PhiTeX verwendet eine kurze feste Verzögerung: eine inkrementelle Neuerstellung dauert etwa 20 ms, eine längere Wartezeit verzögert nur die Vorschau."

#: setzer/dialogs/preferences/pages/page_build_system.py:171
msgid "A running PhiTeX session needs the helper files it writes (.aux, .toc, .bbl) to know what an edit affects, so they are kept."
msgstr "Eine laufende PhiTeX-Sitzung benötigt die von ihr geschriebenen Hilfsdateien (.aux, .toc, .bbl), um zu erkennen, was eine Änderung betrifft — sie bleiben daher erhalten."

#: setzer/dialogs/preferences/pages/page_build_system.py:174
msgid "With a PhiTeX session the build log never pops up on its own: errors show as squiggles in the text and highlighted areas in the preview."
msgstr "Mit einer PhiTeX-Sitzung öffnet sich das Protokoll nie von selbst: Fehler werden als Welllinien im Text und als markierte Bereiche in der Vorschau gezeigt."

#: setzer/dialogs/preferences/pages/page_build_system.py:176
msgid "Auto build is turned off."
msgstr "Automatisches Erstellen ist ausgeschaltet."

#: setzer/dialogs/preferences/pages/page_build_system.py:283
msgid "Output chain only applies when latexmk builds the document."
msgstr "Die Ausgabekette gilt nur, wenn latexmk das Dokument erstellt."

#: setzer/dialogs/preferences/pages/page_build_system.py:456
msgid "Changing this ends the running PhiTeX session; the next build starts a new one with the new setting."
msgstr "Änderungen beenden die laufende PhiTeX-Sitzung; das nächste Erstellen startet eine neue mit der neuen Einstellung."

#: setzer/dialogs/preferences/pages/page_build_system.py:474
msgid "Install PhiTeX on this computer for me: https://github.com/accl-kaust/PhiTeX — a separately built TeX engine I want to use as the LaTeX interpreter in NeoSetzer. Choose whatever is appropriate for this operating system, verify what you download, and install it so that `phitex` is on PATH for my user account without sudo and without writing into system directories. Then check it works and show me what you did. Do not compile PhiTeX into NeoSetzer or bundle it in a NeoSetzer package."
msgstr "Installieren Sie PhiTeX für mich auf diesem Rechner: https://github.com/accl-kaust/PhiTeX — eine separat erstellte TeX-Engine, die ich in NeoSetzer als LaTeX-Interpreter nutzen möchte. Wählen Sie den für dieses Betriebssystem passenden Weg, prüfen Sie, was Sie herunterladen, und installieren Sie so, dass `phitex` im PATH meines Benutzerkontos ohne sudo und ohne Schreiben in Systemverzeichnisse erreichbar ist. Prüfen Sie anschließend, dass es funktioniert, und zeigen Sie mir, was Sie getan haben. Kompilieren Sie PhiTeX nicht in NeoSetzer ein und bundeln Sie es nicht in ein NeoSetzer-Paket."

#: setzer/dialogs/preferences/pages/page_build_system.py:505
msgid "Not found"
msgstr "Nicht gefunden"

#: setzer/dialogs/preferences/pages/page_build_system.py:532
msgid "Could not change PhiTeX’s update check setting."
msgstr "Die Update-Prüfung von PhiTeX ließ sich nicht ändern."

#: setzer/dialogs/preferences/pages/page_build_system.py:544
msgid "Upgrade PhiTeX?"
msgstr "PhiTeX aktualisieren?"

#: setzer/dialogs/preferences/pages/page_build_system.py:545
msgid "PhiTeX will download its latest release, verify it and replace its own binary. NeoSetzer does not download anything. Running sessions are ended so the next build uses the new version."
msgstr "PhiTeX lädt seine neueste Veröffentlichung, prüft sie und ersetzt seine eigene Binärdatei. NeoSetzer lädt nichts herunter. Laufende Sitzungen werden beendet, damit die nächste Erstellung die neue Fassung nutzt."

#: setzer/dialogs/preferences/pages/page_build_system.py:547
#: setzer/dialogs/preferences/pages/page_build_system.py:703
msgid "Upgrade"
msgstr "Aktualisieren"

#: setzer/dialogs/preferences/pages/page_build_system.py:567
#, python-brace-format
msgid "PhiTeX upgraded: {message}"
msgstr "PhiTeX aktualisiert: {message}"

#: setzer/dialogs/preferences/pages/page_build_system.py:568
msgid "PhiTeX upgraded."
msgstr "PhiTeX wurde aktualisiert."

#: setzer/dialogs/preferences/pages/page_build_system.py:570
msgid "PhiTeX could not be upgraded: the command did not run."
msgstr "PhiTeX konnte nicht aktualisiert werden: Der Befehl wurde nicht ausgeführt."

#: setzer/dialogs/preferences/pages/page_build_system.py:572
#, python-brace-format
msgid "PhiTeX could not be upgraded: {message}"
msgstr "PhiTeX konnte nicht aktualisiert werden: {message}"

#: setzer/dialogs/preferences/pages/page_build_system.py:629
msgid "Build system"
msgstr "Build-System"

#: setzer/dialogs/preferences/pages/page_build_system.py:633
msgid "LaTeX interpreter"
msgstr "LaTeX-Interpreter"

#: setzer/dialogs/preferences/pages/page_build_system.py:647
msgid ""
"No LaTeX interpreter found. To install interpreters in Flatpak, open a terminal and run the following command:\n"
"flatpak install org.freedesktop.Sdk.Extension.texlive"
msgstr ""
"Kein LaTeX-Interpreter gefunden. Um Interpreter in Flatpak zu installieren, öffnen Sie ein Terminal und führen Sie folgenden Befehl aus:\n"
"flatpak install org.freedesktop.Sdk.Extension.texlive"

#: setzer/dialogs/preferences/pages/page_build_system.py:650
msgid "No LaTeX interpreter found. For instructions on installing LaTeX see <a href=\"https://en.wikibooks.org/wiki/LaTeX/Installation\">https://en.wikibooks.org/wiki/LaTeX/Installation</a>"
msgstr "Kein LaTeX-Interpreter gefunden. Informationen zur Installation von LaTeX finden Sie auf <a href=\"https://en.wikibooks.org/wiki/LaTeX/Installation\">https://en.wikibooks.org/wiki/LaTeX/Installation</a>"

#: setzer/dialogs/preferences/pages/page_build_system.py:651
msgid "Please note: the Tectonic backend uses only the V1 command-line interface. Tectonic.toml configuration files are ignored. For custom build configuration, switch to another interpreter (see the <a href=\"https://tectonic-typesetting.github.io/tectonic/\">Tectonic documentation</a>)."
msgstr "Hinweis: Das Tectonic-Backend verwendet nur die V1-Befehlszeilenschnittstelle. Tectonic.toml-Konfigurationsdateien werden ignoriert. Wechseln Sie für eine benutzerdefinierte Erstellungskonfiguration zu einer anderen Engine (siehe <a href=\"https://tectonic-typesetting.github.io/tectonic/\">Tectonic-Dokumentation</a>)."

#: setzer/dialogs/preferences/pages/page_build_system.py:655
msgid "PhiTeX builds once to a fixpoint (BibTeX, biber and makeindex included), so the latexmk options below do not apply. Its PDF is byte-identical to pdfLaTeX’s, but LuaLaTeX is not supported yet."
msgstr "PhiTeX erstellt in einem Durchlauf bis zum Fixpunkt (BibTeX, biber und makeindex eingeschlossen), daher gelten die latexmk-Optionen unten nicht. Sein PDF ist byteidentisch mit dem von pdfLaTeX, LuaLaTeX wird jedoch noch nicht unterstützt."

#: setzer/dialogs/preferences/pages/page_build_system.py:658
#: setzer/dialogs/project_build_configuration_viewgtk.py:225
msgid "Interpreter"
msgstr "LaTeX-Interpreter"

#: setzer/dialogs/preferences/pages/page_build_system.py:665
msgid "Install PhiTeX"
msgstr "PhiTeX installieren"

#: setzer/dialogs/preferences/pages/page_build_system.py:666
msgid "Not found on this machine. Copy the instructions and hand them to an AI agent — it will fetch and verify the release for your platform."
msgstr "Auf diesem Rechner nicht gefunden. Kopieren Sie die Anleitung und geben Sie sie an einen KI-Agenten weiter — er lädt die für Ihre Plattform passende Veröffentlichung herunter und prüft sie."

#: setzer/dialogs/preferences/pages/page_build_system.py:670
#: setzer/dialogs/preferences/pages/page_build_system.py:674
msgid "Copy the installation instructions to the clipboard"
msgstr "Installationsanweisung in die Zwischenablage kopieren"

#: setzer/dialogs/preferences/pages/page_build_system.py:684
msgid "PhiTeX"
msgstr "PhiTeX"

#: setzer/dialogs/preferences/pages/page_build_system.py:690
msgid "Version"
msgstr "Version"

#: setzer/dialogs/preferences/pages/page_build_system.py:694
msgid "Let PhiTeX check for updates"
msgstr "PhiTeX nach Aktualisierungen suchen lassen"

#: setzer/dialogs/preferences/pages/page_build_system.py:695
msgid "PhiTeX checks at most once a day, on its own, from its own binary. NeoSetzer never downloads or queries anything for it."
msgstr "PhiTeX prüft höchstens einmal täglich selbst, mit seiner eigenen Binärdatei. NeoSetzer lädt dafür nichts herunter und fragt nichts ab."

#: setzer/dialogs/preferences/pages/page_build_system.py:699
msgid "Upgrade to the latest release"
msgstr "Auf die neueste Veröffentlichung aktualisieren"

#: setzer/dialogs/preferences/pages/page_build_system.py:702
msgid "PhiTeX downloads and verifies its own release. NeoSetzer only runs the command."
msgstr "PhiTeX lädt seine eigene Veröffentlichung herunter und überprüft sie. NeoSetzer führt nur den Befehl aus."

#: setzer/dialogs/preferences/pages/page_build_system.py:709
msgid "Running PhiTeX sessions are ended after an upgrade, so the next build starts on the new version."
msgstr "Laufende PhiTeX-Sitzungen werden nach einer Aktualisierung beendet, damit die nächste Erstellung die neue Fassung verwendet."

#: setzer/dialogs/preferences/pages/page_build_system.py:717
msgid "Remove helper files after building"
msgstr "Hilfsdateien nach dem Erstellen entfernen"

#: setzer/dialogs/preferences/pages/page_build_system.py:719
msgid "The .log, .dvi and similar helper files are deleted once the PDF is built."
msgstr "Die Hilfsdateien (.log, .dvi und ähnliche) werden gelöscht, sobald das PDF erstellt ist."

#: setzer/dialogs/preferences/pages/page_build_system.py:727
msgid "Keep a PhiTeX session running"
msgstr "PhiTeX-Sitzung dauerhaft laufen lassen"

#: setzer/dialogs/preferences/pages/page_build_system.py:728
msgid "Rebuild only what the edit affects by reusing one running PhiTeX process per document. Turning this off re-starts PhiTeX for every build, which recompiles the whole document each time."
msgstr "Es wird nur das neu erstellt, was die Änderung betrifft, indem je Dokument ein laufender PhiTeX-Prozess weiterverwendet wird. Ohne diese Option wird PhiTeX bei jedem Erstellen neu gestartet und jedes Mal das gesamte Dokument neu kompiliert."

#: setzer/dialogs/preferences/pages/page_build_system.py:738
msgid "Precise SyncTeX in the background"
msgstr "Präzises SyncTeX im Hintergrund"

#: setzer/dialogs/preferences/pages/page_build_system.py:739
msgid "While PhiTeX live preview is active, regenerate SyncTeX with the native TeX engine in the background for accurate jumping. Jumping is briefly unavailable while it updates."
msgstr "Solange die PhiTeX-Live-Vorschau aktiv ist, wird SyncTeX im Hintergrund mit der nativen TeX-Engine neu erzeugt, um präzise Sprünge zu ermöglichen. Während der Aktualisierung ist das Springen kurzzeitig nicht verfügbar."

#: setzer/dialogs/preferences/pages/page_build_system.py:747
msgid "Output chain"
msgstr "Ausgabe-Kette"

#: setzer/dialogs/preferences/pages/page_build_system.py:750
msgid "Needed by PSTricks and psfrag; the interpreter choice is bypassed on this route."
msgstr "Von PSTricks und psfrag benötigt; auf diesem Weg wird die Interpreter-Awahl umgangen."

#: setzer/dialogs/preferences/pages/page_build_system.py:752
msgid "Direct PDF"
msgstr "Direktes PDF"

#: setzer/dialogs/preferences/pages/page_build_system.py:753
msgid "PDF via PostScript (DVI → dvips → ps2pdf)"
msgstr "PDF via PostScript (DVI → dvips → ps2pdf)"

#: setzer/dialogs/preferences/pages/page_build_system.py:759
msgid "Generate SyncTeX for preview sync"
msgstr "SyncTeX für Vorschau-Synchronisation erzeugen"

#: setzer/dialogs/preferences/pages/page_build_system.py:760
msgid "Enables forward/reverse sync between editor and PDF preview. Disabling makes builds slightly faster."
msgstr "Aktiviert Vorwärts-/Rückwärts-Synchronisation zwischen Editor und PDF-Vorschau. Deaktivieren beschleunigt Build-Vorgänge geringfügig."

#: setzer/dialogs/preferences/pages/page_build_system.py:764
msgid "Elapsed-time counter on the build button"
msgstr "Zeitzähler am Erstellungsknopf"

#: setzer/dialogs/preferences/pages/page_build_system.py:767
msgid "Shown automatically for slower interpreters; hidden with PhiTeX live builds."
msgstr "Wird bei langsameren Interpretern automatisch angezeigt; bei PhiTeX-Live-Erstellungen ausgeblendet."

#: setzer/dialogs/preferences/pages/page_build_system.py:769
msgid "Show once the build passes a second"
msgstr "Anzeigen, sobald die Erstellung eine Sekunde überschreitet"

#: setzer/dialogs/preferences/pages/page_build_system.py:770
msgid "Always show"
msgstr "Immer anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:771
msgid "Never show"
msgstr "Nie anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:777
msgid "Auto build"
msgstr "Automatische Erstellung"

#: setzer/dialogs/preferences/pages/page_build_system.py:781
msgid "Automatically build and save after changes"
msgstr "Nach Änderungen automatisch erstellen und speichern"

#: setzer/dialogs/preferences/pages/page_build_system.py:782
msgid "When you stop typing, the document is saved and rebuilt after a short delay."
msgstr "Wenn Sie das Tippen beenden, wird das Dokument gespeichert und nach kurzer Verzögerung neu erstellt."

#: setzer/dialogs/preferences/pages/page_build_system.py:786
msgid "Delay (seconds)"
msgstr "Verzögerung (Sekunden)"

#: setzer/dialogs/preferences/pages/page_build_system.py:788
msgid "Shorter delays update the preview faster but use more CPU while typing."
msgstr "Kürzere Verzögerungen aktualisieren die Vorschau schneller, verbrauchen beim Tippen jedoch mehr CPU-Leistung."

#: setzer/dialogs/preferences/pages/page_build_system.py:799
msgid "Pop up build log on auto-build errors"
msgstr "Bei Fehlern beim automatischen Erstellen das Protokoll anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:801
msgid "When auto-build is on, automatically show the build log when errors occur. Disable to avoid interruptions while typing."
msgstr "Wenn die automatische Erstellung aktiv ist, wird bei Fehlern automatisch das Protokoll angezeigt. Deaktivieren, um Unterbrechungen beim Tippen zu vermeiden."

#: setzer/dialogs/preferences/pages/page_build_system.py:812
msgid "Automatically show build log"
msgstr "Erstellungsprotokoll automatisch anzeigen"

#: setzer/dialogs/preferences/pages/page_build_system.py:814
msgid "Only when errors occur"
msgstr "Nur bei Fehlern"

#: setzer/dialogs/preferences/pages/page_build_system.py:815
msgid "On errors and warnings"
msgstr "Bei Fehlern und Warnungen"

#: setzer/dialogs/preferences/pages/page_build_system.py:816
msgid "On errors, warnings and badboxes"
msgstr "Bei Fehlern, Warnungen und Badboxes"

#: setzer/dialogs/preferences/pages/page_build_system.py:817
msgid "Never"
msgstr "Nie"

#: setzer/dialogs/preferences/pages/page_build_system.py:823
msgid "Embedded system commands"
msgstr "Systembefehle einbetten"

#: setzer/dialogs/preferences/pages/page_build_system.py:842
msgid "Warning: enable this only if you have to. It can cause security problems when building files from untrusted sources."
msgstr "Vorsicht: nur aktivieren, wenn es sein muss. Es kann zu Sicherheitsproblemen mit Dateien aus nicht vertrauenswürdiger Quelle kommen."

