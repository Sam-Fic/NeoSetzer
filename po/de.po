msgstr "Maximale Rückgängig-Tiefe"

#: setzer/dialogs/preferences/pages/page_editor.py:889
msgid "Maximum number of undo steps. 0 = unlimited."
msgstr "Maximale Anzahl von Rückgängig-Schritten. 0 = unbegrenzt."

#: setzer/dialogs/preferences/pages/page_editor.py:891
msgid "Lower values save memory for very large documents. 0 keeps an unlimited history."
msgstr "Niedrigere Werte sparen Speicher bei sehr großen Dokumenten. 0 = unbegrenzt."

#: setzer/dialogs/preferences/pages/page_editor.py:898
msgid "Line numbers"
msgstr "Zeilennummern"

#: setzer/dialogs/preferences/pages/page_editor.py:902
msgid "Show line numbers"
msgstr "Zeilennummern anzeigen"

#: setzer/dialogs/preferences/pages/page_editor.py:903
msgid "Display line numbers in the editor gutter."
msgstr "Zeilennummern im Editor-Rand anzeigen."

#: setzer/dialogs/preferences/pages/page_editor.py:907
msgid "Right margin"
msgstr "Rechter Rand"

#: setzer/dialogs/preferences/pages/page_editor.py:911
