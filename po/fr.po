"Directories where the preview dialog is skipped. Click delete to revoke "
"trust for a project."
msgstr ""
"Répertoires où la boîte de dialogue d'aperçu est ignorée. Cliquez sur "
"supprimer pour révoquer la confiance d'un projet."

#: setzer/dialogs/preferences/pages/page_build_system.py:704
msgid "Add custom tool"
msgstr "Ajouter un outil personnalisé"

#: setzer/dialogs/preferences/pages/page_build_system.py:734
msgid "Tool name (unique)"
msgstr "Nom de l'outil (unique)"

#: setzer/dialogs/preferences/pages/page_build_system.py:738
msgid "Executable (e.g. aider)"
msgstr "Exécutable (p. ex. aider)"

#: setzer/dialogs/preferences/pages/page_build_system.py:742
msgid "Headed command template"
msgstr "Modèle de commande avec fenêtre"

#: setzer/dialogs/preferences/pages/page_build_system.py:744
#, python-brace-format
msgid ""
"Space-separated args. Use {prompt} / {file} / {cwd} as placeholders. "
"Example: aider --message {prompt} --no-auto-commits. If left blank or "
"without {prompt}, the prompt is copied to clipboard."
msgstr ""
"Arguments séparés par des espaces. Utilisez {prompt} / {file} / {cwd} comme "
"espaces réservés. Exemple : aider --message {prompt} --no-auto-commits. Si "
"laissé vide ou sans {prompt}, l'invite est copiée dans le presse-papiers."

#: setzer/dialogs/preferences/pages/page_editor.py:159
msgid "Unavailable: install pyenchant and hunspell dictionaries to enable."
msgstr ""
"Indisponible : installez pyenchant et les dictionnaires hunspell pour "
"activer."

#: setzer/dialogs/preferences/pages/page_editor.py:287
msgid "Select previous suggestion"
msgstr "Sélectionner la suggestion précédente"

#: setzer/dialogs/preferences/pages/page_editor.py:288
msgid "Move the selection up one item in the completion popup."
msgstr ""
"Déplacer la sélection d'un élément vers le haut dans la fenêtre de "
"complétion."

#: setzer/dialogs/preferences/pages/page_editor.py:289
msgid "Select next suggestion"
msgstr "Sélectionner la suggestion suivante"

#: setzer/dialogs/preferences/pages/page_editor.py:290
msgid "Move the selection down one item in the completion popup."
msgstr ""
"Déplacer la sélection d'un élément vers le bas dans la fenêtre de "
"complétion."

#: setzer/dialogs/preferences/pages/page_editor.py:291
msgid "Previous page"
msgstr "Page précédente"

#: setzer/dialogs/preferences/pages/page_editor.py:292
msgid "Scroll the completion popup up one page."
msgstr "Faire défiler la fenêtre de complétion d'une page vers le haut."

#: setzer/dialogs/preferences/pages/page_editor.py:293
msgid "Next page"
msgstr "Page suivante"

#: setzer/dialogs/preferences/pages/page_editor.py:294
msgid "Scroll the completion popup down one page."
msgstr "Faire défiler la fenêtre de complétion d'une page vers le bas."

#: setzer/dialogs/preferences/pages/page_editor.py:295
msgid "Accept suggestion"
msgstr "Accepter la suggestion"

#: setzer/dialogs/preferences/pages/page_editor.py:296
msgid "Insert the currently selected completion."
msgstr "Insérer la complétion actuellement sélectionnée."

#: setzer/dialogs/preferences/pages/page_editor.py:297
msgid "Dismiss popup"
msgstr "Fermer la fenêtre"

#: setzer/dialogs/preferences/pages/page_editor.py:298
msgid "Close the completion popup without inserting anything."
msgstr "Fermer la fenêtre de complétion sans insérer quoi que ce soit."

#: setzer/dialogs/preferences/pages/page_editor.py:304
msgid "Disabled"
msgstr "Désactivé"

#: setzer/dialogs/preferences/pages/page_editor.py:372
msgid "Press a shortcut… (Esc to cancel)"
msgstr "Appuyez sur un raccourci… (Échap pour annuler)"

#: setzer/dialogs/preferences/pages/page_editor.py:454
msgid "Font size is too small; clamped to 6pt minimum."
msgstr "Taille de police trop petite ; limitée à un minimum de 6 pt."

#: setzer/dialogs/preferences/pages/page_editor.py:456
msgid "Font size is too large; clamped to 24pt maximum."
msgstr "Taille de police trop grande ; limitée à un maximum de 24 pt."

#: setzer/dialogs/preferences/pages/page_editor.py:706
msgid "Font"
msgstr "Police"

#: setzer/dialogs/preferences/pages/page_editor.py:711
msgid "Use the system fixed width font"
msgstr "Utiliser la police à chasse fixe du système"

#: setzer/dialogs/preferences/pages/page_editor.py:714
msgid ""
"Use the system fixed-width font for editing. When enabled, the font set "
"below is overridden."
msgstr ""
"Utiliser la police à chasse fixe du système pour l'édition. Lorsqu'elle est "
"activée, la police définie ci-dessous est remplacée."

#: setzer/dialogs/preferences/pages/page_editor.py:721
msgid "Set Editor Font"
msgstr "Définir la police de l'éditeur"

#: setzer/dialogs/preferences/pages/page_editor.py:724
msgid ""
"Choose a custom font for the LaTeX editor. Only active when \"Use the system"
" fixed width font\" is off."
msgstr ""
"Choisir une police personnalisée pour l'éditeur LaTeX. Active uniquement "
"lorsque « Utiliser la police à chasse fixe du système » est désactivé."

#: setzer/dialogs/preferences/pages/page_editor.py:729
msgid "Line Spacing"
msgstr "Interligne"

#: setzer/dialogs/preferences/pages/page_editor.py:730
msgid "Extra vertical space between lines in pixels."
msgstr "Espace vertical supplémentaire entre les lignes, en pixels."

#: setzer/dialogs/preferences/pages/page_editor.py:732
msgid ""
"Extra vertical space between lines, in pixels. Affects readability and line "
"density in the editor."
msgstr ""
"Espace vertical supplémentaire entre les lignes, en pixels. Influence la "
"lisibilité et la densité des lignes dans l'éditeur."

#: setzer/dialogs/preferences/pages/page_editor.py:739
msgid "Tab Stops"
msgstr "Taquets de tabulation"

#: setzer/dialogs/preferences/pages/page_editor.py:743
msgid "Insert spaces instead of tabs"
msgstr "Insérer des espaces au lieu de tabulations"

#: setzer/dialogs/preferences/pages/page_editor.py:744
msgid "Use spaces when pressing Tab, instead of a tab character."
msgstr ""
"Utiliser des espaces à l'appui de Tab, au lieu d'un caractère de tabulation."

#: setzer/dialogs/preferences/pages/page_editor.py:746
msgid "When enabled, pressing Tab inserts spaces instead of a tab character."
msgstr ""
"Lorsqu'elle est activée, l'appui sur Tab insère des espaces au lieu d'un "
"caractère de tabulation."

#: setzer/dialogs/preferences/pages/page_editor.py:754
msgid ""
"Number of spaces a tab character occupies when \"Insert spaces instead of "
"tabs\" is enabled."
msgstr ""
"Nombre d'espaces qu'occupe un caractère de tabulation lorsque « Insérer des "
"espaces au lieu de tabulations » est activé."

#: setzer/dialogs/preferences/pages/page_editor.py:766
msgid "Maximum undo depth"
msgstr "Profondeur d'annulation maximale"

#: setzer/dialogs/preferences/pages/page_editor.py:767
msgid "Maximum number of undo steps. 0 = unlimited."
msgstr "Nombre maximal d'étapes d'annulation. 0 = illimité."

#: setzer/dialogs/preferences/pages/page_editor.py:769
msgid ""
"Limit the number of undoable actions kept in memory. Lower values save "
"memory for very large documents. 0 keeps an unlimited history."
msgstr ""
"Limite le nombre d'actions annulables conservées en mémoire. Des valeurs "
"plus faibles économisent la mémoire pour les très grands documents. 0 "
"conserve un historique illimité."

#: setzer/dialogs/preferences/pages/page_editor.py:777
msgid "Line Numbers"
msgstr "Numéros de ligne"

#: setzer/dialogs/preferences/pages/page_editor.py:781
msgid "Show line numbers"
msgstr "Afficher les numéros de ligne"

#: setzer/dialogs/preferences/pages/page_editor.py:782
msgid "Display line numbers in the editor gutter."
msgstr "Afficher les numéros de ligne dans la gouttière de l'éditeur."

#: setzer/dialogs/preferences/pages/page_editor.py:784
msgid "Display line numbers in the left gutter of the editor."
msgstr "Afficher les numéros de ligne dans la gouttière gauche de l'éditeur."

#: setzer/dialogs/preferences/pages/page_editor.py:788
msgid "Right Margin"
msgstr "Marge droite"

#: setzer/dialogs/preferences/pages/page_editor.py:792
msgid "Show right margin guide"
msgstr "Afficher le guide de marge droite"

#: setzer/dialogs/preferences/pages/page_editor.py:793
msgid "Display a vertical line at a fixed column."
msgstr "Afficher une ligne verticale à une colonne fixe."

#: setzer/dialogs/preferences/pages/page_editor.py:795
msgid ""
"Display a vertical line at a fixed column position to help keep lines within"
" a recommended width."
msgstr ""
"Afficher une ligne verticale à une position de colonne fixe pour aider à "
"garder les lignes dans une largeur recommandée."

#: setzer/dialogs/preferences/pages/page_editor.py:800
msgid "Right margin column"
msgstr "Colonne de marge droite"

#: setzer/dialogs/preferences/pages/page_editor.py:801
msgid "Column position for the right margin guide."
msgstr "Position de colonne pour le guide de marge droite."

#: setzer/dialogs/preferences/pages/page_editor.py:803
msgid ""
"Column position for the right margin guide vertical line. LaTeX documents "
"are typically kept within 80 columns."
msgstr ""
"Position de la colonne pour la ligne verticale du guide de marge droite. Les"
" documents LaTeX sont généralement conservés dans une limite de 80 colonnes."

#: setzer/dialogs/preferences/pages/page_editor.py:810
msgid "Shortcuts Bar"
msgstr "Barre de raccourcis"

#: setzer/dialogs/preferences/pages/page_editor.py:814
msgid "Show shortcuts bar"
msgstr "Afficher la barre de raccourcis"

#: setzer/dialogs/preferences/pages/page_editor.py:815
msgid "Display the shortcuts bar above the editor."
msgstr "Afficher la barre de raccourcis au-dessus de l'éditeur."

#: setzer/dialogs/preferences/pages/page_editor.py:817
msgid "Display a bar of keyboard shortcuts above the editor."
msgstr "Afficher une barre de raccourcis clavier au-dessus de l'éditeur."

#: setzer/dialogs/preferences/pages/page_editor.py:821
msgid "Tab Bar"
msgstr "Barre d'onglets"

#: setzer/dialogs/preferences/pages/page_editor.py:825
msgid "Show tab bar"
msgstr "Afficher la barre d'onglets"

#: setzer/dialogs/preferences/pages/page_editor.py:826
msgid "Display the multi-document tab bar above the shortcuts bar."
msgstr ""
"Afficher la barre d'onglets multi-documents au-dessus de la barre de "
"raccourcis."

#: setzer/dialogs/preferences/pages/page_editor.py:828
msgid ""
"Display a bar of open documents above the shortcuts bar. When enabled, a "
"single open document hides the bar automatically."
msgstr ""
"Afficher une barre des documents ouverts au-dessus de la barre de "
"raccourcis. Lorsqu'activée, un seul document ouvert masque automatiquement "
"la barre."

#: setzer/dialogs/preferences/pages/page_editor.py:833
msgid "Line Wrapping"
msgstr "Retour à la ligne"

#: setzer/dialogs/preferences/pages/page_editor.py:837
msgid "Enable line wrapping"
msgstr "Activer le retour à la ligne"

#: setzer/dialogs/preferences/pages/page_editor.py:838
msgid "Wrap long lines instead of scrolling horizontally."
msgstr "Replier les longues lignes au lieu de faire défiler horizontalement."

#: setzer/dialogs/preferences/pages/page_editor.py:840
msgid ""
"Wrap long lines to fit within the editor window instead of scrolling "
"horizontally."
msgstr ""
"Couper les lignes longues pour qu'elles tiennent dans la fenêtre de "
"l'éditeur au lieu d'un défilement horizontal."

#: setzer/dialogs/preferences/pages/page_editor.py:845
msgid "Code Folding"
msgstr "Repli de code"

#: setzer/dialogs/preferences/pages/page_editor.py:849
msgid "Enable code folding"
msgstr "Activer le pliage de code"

#: setzer/dialogs/preferences/pages/page_editor.py:850
msgid "Allow collapsing blocks of code such as environments."
msgstr "Permettre de replier les blocs de code tels que les environnements."

#: setzer/dialogs/preferences/pages/page_editor.py:852
msgid ""
"Allow collapsing and expanding code blocks such as LaTeX environments, "
"sections, and functions."
msgstr ""
"Permettre de replier et déplier les blocs de code tels que les "
"environnements LaTeX, les sections et les fonctions."

#: setzer/dialogs/preferences/pages/page_editor.py:857
msgid "Sticky Scroll"
msgstr "Défilement collant"

#: setzer/dialogs/preferences/pages/page_editor.py:861
msgid "Enable sticky scroll for sections"
msgstr "Activer le défilement persistant des sections"

#: setzer/dialogs/preferences/pages/page_editor.py:862
msgid ""
"Show the current section header at the top of the editor while scrolling."
msgstr ""
"Afficher l'en-tête de section actuel en haut de l'éditeur lors du "
"défilement."

#: setzer/dialogs/preferences/pages/page_editor.py:864
msgid ""
"Displays a sticky header at the top of the editor showing the current "
"section hierarchy (chapter, section, subsection, etc.) as you scroll through"
" long documents."
msgstr ""
"Affiche un en-tête persistant en haut de l'éditeur montrant la hiérarchie de"
" section actuelle (chapitre, section, sous-section, etc.) lors du défilement"
" dans les documents longs."

#: setzer/dialogs/preferences/pages/page_editor.py:870
msgid "Highlighting"
msgstr "Surlignage"

#: setzer/dialogs/preferences/pages/page_editor.py:874
msgid "Highlight current line"
msgstr "Surligner la ligne actuelle"

#: setzer/dialogs/preferences/pages/page_editor.py:875
msgid "Visually emphasize the line containing the cursor."
msgstr "Mettre visuellement en évidence la ligne contenant le curseur."

#: setzer/dialogs/preferences/pages/page_editor.py:877
msgid "Visually highlight the line where the cursor is located."
msgstr "Surligner visuellement la ligne où se trouve le curseur."

#: setzer/dialogs/preferences/pages/page_editor.py:881
msgid "Highlight matching brackets"
msgstr "Surligner les crochets correspondants"

#: setzer/dialogs/preferences/pages/page_editor.py:882
msgid "Highlight the bracket matching the one next to the cursor."
msgstr "Surligner la parenthèse correspondant à celle à côté du curseur."

#: setzer/dialogs/preferences/pages/page_editor.py:884
msgid "Highlight the bracket that matches the one next to the cursor."
msgstr "Surligner la parenthèse qui correspond à celle à côté du curseur."

#: setzer/dialogs/preferences/pages/page_editor.py:888
msgid "Highlight matching \\begin/\\end"
msgstr "Surligner les \\begin/\\end correspondants"

#: setzer/dialogs/preferences/pages/page_editor.py:889
msgid ""
"Highlight the environment matching the \\begin or \\end command next to the "
"cursor."
msgstr ""
"Surligner l'environnement correspondant à la commande \\begin ou \\end à "
"côté du curseur."

#: setzer/dialogs/preferences/pages/page_editor.py:891
msgid ""
"Highlight the \\begin{...}/\\end{...} pair that matches the one next to the "
"cursor."
msgstr ""
"Surligner la paire \\begin{...}/\\end{...} qui correspond à celle à côté du "
"curseur."

#: setzer/dialogs/preferences/pages/page_editor.py:896
msgid "Spell Checking"
msgstr "Vérification orthographique"

#: setzer/dialogs/preferences/pages/page_editor.py:900
msgid "Check spelling as you type"
msgstr "Vérifier l'orthographe pendant la frappe"

#: setzer/dialogs/preferences/pages/page_editor.py:902
msgid ""
"Underline misspelled words in the text. Commands, math and verbatim regions "
"are skipped."
msgstr ""
"Souligner les mots mal orthographiés dans le texte. Les commandes, les "
"formules mathématiques et les zones verbatim sont ignorées."

#: setzer/dialogs/preferences/pages/page_editor.py:905
msgid ""
"Check spelling as you type using enchant/hunspell dictionaries. LaTeX "
"commands, math mode and verbatim environments are not checked. Right-click a"
" marked word for suggestions."
msgstr ""
"Vérifier l'orthographe pendant la frappe à l'aide des dictionnaires "
"enchant/hunspell. Les commandes LaTeX, le mode mathématique et les "
"environnements verbatim ne sont pas vérifiés. Clic droit sur un mot marqué "
"pour des suggestions."

#: setzer/dialogs/preferences/pages/page_editor.py:912
msgid "Dictionary used for spell checking"
msgstr "Dictionnaire utilisé pour la vérification orthographique"

#: setzer/dialogs/preferences/pages/page_editor.py:914
msgid ""
"The dictionary language for spell checking. Additional languages can be "
"installed via hunspell/aspell packages."
msgstr ""
"La langue du dictionnaire pour la vérification orthographique. Des langues "
"supplémentaires peuvent être installées via les paquets hunspell/aspell."

#: setzer/dialogs/preferences/pages/page_editor.py:919
msgid "Manage Words"
msgstr "Gérer les mots"

#: setzer/dialogs/preferences/pages/page_editor.py:921
msgid "View and edit ignored words and your user dictionary"
msgstr ""
"Consulter et modifier les mots ignorés et votre dictionnaire utilisateur"

#: setzer/dialogs/preferences/pages/page_editor.py:923
msgid ""
"Manage the words you ignored for the current session and the words saved "
"permanently to your user dictionary."
msgstr ""
"Gérer les mots que vous avez ignorés pour la session actuelle et les mots "
"enregistrés définitivement dans votre dictionnaire utilisateur."

#: setzer/dialogs/preferences/pages/page_editor.py:933
msgid "Visible Characters"
msgstr "Caractères visibles"

#: setzer/dialogs/preferences/pages/page_editor.py:937
msgid "Show line endings"
msgstr "Afficher les fins de ligne"

#: setzer/dialogs/preferences/pages/page_editor.py:938
msgid "Display line ending characters (¶) at the end of each line."
msgstr "Afficher les caractères de fin de ligne (¶) à la fin de chaque ligne."

#: setzer/dialogs/preferences/pages/page_editor.py:940
msgid ""
"Display a paragraph symbol (¶) at the end of each line to help identify "
"trailing whitespace and line ending issues."
msgstr ""
"Afficher un symbole de paragraphe (¶) à la fin de chaque ligne pour aider à "
"repérer les espaces de fin et les problèmes de fins de ligne."

#: setzer/dialogs/preferences/pages/page_editor.py:945
msgid "Show whitespace"
msgstr "Afficher les espaces"

#: setzer/dialogs/preferences/pages/page_editor.py:946
msgid "Display whitespace characters (· for spaces, → for tabs)."
msgstr ""
"Afficher les caractères d'espacement (· pour les espaces, → pour les "
"tabulations)."

#: setzer/dialogs/preferences/pages/page_editor.py:948
msgid ""
"Display symbols for spaces (·) and tabs (→) to help debug indentation and "
"trailing whitespace issues."
msgstr ""
"Afficher des symboles pour les espaces (·) et les tabulations (→) pour aider"
" à déboguer l'indentation et les espaces de fin de ligne."

#: setzer/dialogs/preferences/pages/page_editor.py:955
msgid "Auto Save"
msgstr "Enregistrement automatique"

#: setzer/dialogs/preferences/pages/page_editor.py:959
msgid "Enable auto save (crash recovery)"
msgstr "Activer l'enregistrement automatique (récupération après incident)"

#: setzer/dialogs/preferences/pages/page_editor.py:960
msgid "Periodically save buffer to a temp file for crash recovery"
msgstr ""
"Enregistrer périodiquement le tampon dans un fichier temporaire pour la "
"récupération après incident."

#: setzer/dialogs/preferences/pages/page_editor.py:962
msgid ""
"Periodically save the buffer to a temporary file for crash recovery. Setzer "
"can restore unsaved edits after an unexpected application exit."
msgstr ""
"Enregistrer périodiquement le tampon dans un fichier temporaire pour la "
"récupération après incident. Setzer peut restaurer les modifications non "
"enregistrées après une fermeture inattendue de l'application."

#: setzer/dialogs/preferences/pages/page_editor.py:968
msgid "Auto save interval (seconds)"
msgstr "Intervalle d'enregistrement automatique (secondes)"

#: setzer/dialogs/preferences/pages/page_editor.py:972
msgid ""
"Time interval in seconds between automatic saves when auto save is enabled."
msgstr ""
"Intervalle en secondes entre les enregistrements automatiques lorsque "
"l'enregistrement automatique est activé."

#: setzer/dialogs/preferences/pages/page_editor.py:978
msgid "External Changes"
msgstr "Modifications externes"

#: setzer/dialogs/preferences/pages/page_editor.py:982
msgid "Automatically reload changed files"
msgstr "Recharger automatiquement les fichiers modifiés"

#: setzer/dialogs/preferences/pages/page_editor.py:984
msgid "Reload files modified by external applications without prompting"
msgstr ""
"Recharger les fichiers modifiés par des applications externes sans demander "
"confirmation."

#: setzer/dialogs/preferences/pages/page_editor.py:986
msgid ""
"Automatically reload files modified by external applications without showing"
" a prompt. Unsaved changes in the editor will be lost."
msgstr ""
"Recharger automatiquement les fichiers modifiés par des applications "
"externes sans afficher d'invite. Les modifications non enregistrées dans "
"l'éditeur seront perdues."

#: setzer/dialogs/preferences/pages/page_editor.py:994
msgid "Git Integration"
msgstr "Intégration Git"

#: setzer/dialogs/preferences/pages/page_editor.py:998
msgid "Enable Git integration"
msgstr "Activer l'intégration Git"

#: setzer/dialogs/preferences/pages/page_editor.py:999
msgid "Detect repositories and run git commands for open documents"
msgstr ""
"Détecter les dépôts et exécuter des commandes git pour les documents ouverts"

#: setzer/dialogs/preferences/pages/page_editor.py:1003
msgid "Show change marks in the line number column"
msgstr ""
"Afficher les marques de modification dans la colonne des numéros de ligne"

#: setzer/dialogs/preferences/pages/page_editor.py:1004
msgid "Added, modified and deleted lines relative to HEAD"
msgstr "Lignes ajoutées, modifiées et supprimées par rapport à HEAD"

#: setzer/dialogs/preferences/pages/page_editor.py:1008
msgid "Show the Git sidebar panel"
msgstr "Afficher le panneau latéral Git"

#: setzer/dialogs/preferences/pages/page_editor.py:1009
