#: data/org.cvfosammmm.Setzer.metainfo.xml.in:8
msgid "Simple yet full-featured LaTeX editor (fork of Setzer)"
msgstr "Éditeur LaTeX simple mais complet (fork de Setzer)"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:15
msgid ""
"NeoSetzer lets you Write LaTeX documents with an easy to use yet full-"
"featured editor. It is a fork of the Setzer project."
msgstr ""
"NeoSetzer vous permet de rédiger des documents LaTeX avec un éditeur à la "
"fois simple d'utilisation et complet. Il s'agit d'un fork du projet Setzer."

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:16
msgid "Features include:"
msgstr "Fonctionnalités :"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:18
#: data/org.cvfosammmm.Setzer.metainfo.xml.in:33
msgid "Buttons and shortcuts for many LaTeX elements and special characters"
msgstr ""
"Boutons et raccourcis pour de nombreux éléments LaTeX et caractères spéciaux"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:19
msgid "Comfortable document creation wizard"
msgstr "Assistant de création de document convivial"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:20
#: data/org.cvfosammmm.Setzer.metainfo.xml.in:41
msgid "Dark mode"
msgstr "Mode sombre"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:21
#: data/org.cvfosammmm.Setzer.metainfo.xml.in:45
msgid "Helpful error messages in the build log"
msgstr "Messages d'erreur explicites dans le journal de compilation"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:22
msgid "Looks great on the Gnome desktop"
msgstr "Un rendu de qualité sur le bureau GNOME"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:23
msgid "Good screen to content ratio"
msgstr "Un bon rapport entre l'interface et le contenu"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:24
msgid "Arguably the best .pdf viewer of any LaTeX editor"
msgstr "Sans doute la meilleure visionneuse PDF parmi les éditeurs LaTeX"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:37
msgid "Document creation wizard"
msgstr "Assistant de création de document"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:72
msgid "Fork maintenance release (development continued from v67):"
msgstr ""
"Version de maintenance du fork (développement poursuivi depuis la v67) :"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:74
msgid "UI polish: welcome screen, header bar, document wizard, preview panel"
msgstr ""
"Améliorations de l'interface : écran d'accueil, barre d'en-tête, assistant "
"de document, panneau d'aperçu"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:75
msgid "Refactor gutter rendering and preview panel widgets"
msgstr "Refonte du rendu de la gouttière et des widgets du panneau d'aperçu"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:76
msgid "Add per-PDF theme color matching preference"
msgstr ""
"Ajout d'une préférence d'harmonisation des couleurs avec le thème pour "
"chaque PDF"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:77
msgid "Default highlight-current-line to on"
msgstr "Surbrillance de la ligne courante activée par défaut"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:78
msgid "Packaging: add standard Debian (.deb) build flow"
msgstr "Emballage : ajout du processus de compilation Debian (.deb) standard"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:84
msgid "Modernize GUI to latest GTK4 and libadwaita standards:"
msgstr ""
"Modernisation de l'interface selon les derniers standards GTK4 et libadwaita"
" :"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:86
msgid "Upgrade to Adw.PreferencesDialog for preferences"
msgstr "Migration des préférences vers Adw.PreferencesDialog"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:87
msgid "Upgrade to Adw.ShortcutsDialog for keyboard shortcuts"
msgstr "Migration des raccourcis clavier vers Adw.ShortcutsDialog"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:88
msgid "Replace all deprecated GTK4 API calls"
msgstr "Remplacement de tous les appels d'API GTK4 obsolètes"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:89
msgid "Update Flatpak runtime to GNOME 48"
msgstr "Mise à jour du runtime Flatpak vers GNOME 48"

#: data/org.cvfosammmm.Setzer.metainfo.xml.in:95
msgid "Mostly bugfixes, ..."
msgstr "Essentiellement des corrections de bogues, ..."

#: setzer/dialogs/about/about.py:45
msgid "NeoSetzer is a LaTeX editor."
msgstr "NeoSetzer est un éditeur LaTeX."

#: setzer/dialogs/about/about.py:50
msgid "Fork Repository"
msgstr "Dépôt du fork"

#: setzer/dialogs/about/about.py:54
msgid ""
"\n"
"<ul>\n"
"<li>Performance improvements and bug fixes</li>\n"
"<li>Improved keyboard shortcuts</li>\n"
"<li>Added print functionality</li>\n"
"<li>Enhanced preview keyboard navigation</li>\n"
"<li>Better error handling for file operations</li>\n"
"</ul>"
msgstr ""
"\n"
"<ul>\n"
"<li>Améliorations des performances et corrections de bogues</li>\n"
"<li>Raccourcis clavier améliorés</li>\n"
"<li>Ajout de la fonctionnalité d'impression</li>\n"
"<li>Navigation clavier dans l'aperçu améliorée</li>\n"
"<li>Meilleure gestion des erreurs lors des opérations sur les fichiers</li>\n"
"</ul>"

