msgstr "PhiTeX"

#: setzer/dialogs/preferences/pages/page_build_system.py:581
msgid "Version"
msgstr "Version"

#: setzer/dialogs/preferences/pages/page_build_system.py:585
msgid "Let PhiTeX check for updates"
msgstr "Laisser PhiTeX rechercher les mises à jour"

#: setzer/dialogs/preferences/pages/page_build_system.py:586
msgid "PhiTeX checks at most once a day, on its own, from its own binary. NeoSetzer never downloads or queries anything for it."
msgstr "PhiTeX vérifie au plus une fois par jour, de lui-même, depuis son propre binaire. NeoSetzer ne télécharge ni n’interroge jamais rien pour cela."

#: setzer/dialogs/preferences/pages/page_build_system.py:590
msgid "Upgrade to the latest release"
msgstr "Mettre à jour vers la dernière version"

#: setzer/dialogs/preferences/pages/page_build_system.py:591
msgid "PhiTeX downloads and verifies its own release, then replaces its binary by rename. NeoSetzer only runs the command."
msgstr "PhiTeX télécharge et vérifie lui-même sa version, puis remplace son binaire par renommage. NeoSetzer se contente d’exécuter la commande."

