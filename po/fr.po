#: setzer/dialogs/document_wizard/pages/page_document_class.py:181
msgid ""
"<b>Article:</b>  For articles in scientific journals, term papers, handouts, short reports, …\n"
"\n"
"This class on its own is pretty simplistic and is often used as a starting point for more custom layouts."
msgstr ""
"<b>Article :</b>  Pour les articles de revues scientifiques, mémoires, polycopiés, rapports courts, …\n"
"\n"
"Cette classe est assez simple en soi et sert souvent de point de départ pour des mises en page plus personnalisées."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:182
msgid "<b>Book:</b>  For actual books containing many chapters and sections."
msgstr "<b>Book :</b>  Pour les livres proprement dits comportant de nombreux chapitres et sections."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:183
msgid "<b>Report:</b>  For longer reports and articles containing more than one chapter, small books, thesis."
msgstr "<b>Report :</b>  Pour les rapports plus longs et les articles comportant plus d'un chapitre, les petits livres, les thèses."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:184
msgid "<b>Letter:</b>  For writing letters."
msgstr "<b>Letter :</b>  Pour écrire des lettres."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:185
msgid ""
"<b>Beamer:</b>  A class for making presentation slides with LaTeX.\n"
"\n"
"There are many predefined presentation styles."
msgstr ""
"<b>Beamer :</b>  Une classe pour créer des diapositives de présentation avec LaTeX.\n"
"\n"
"Il existe de nombreux styles de présentation prédéfinis."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:187
msgid "<b>Scrartcl:</b>  KOMA-Script replacement for the article class. Adds many customizations and sensible defaults."
msgstr "<b>Scrartcl :</b>  Remplacement KOMA-Script de la classe article. Ajoute de nombreuses personnalisations et des valeurs par défaut judicieuses."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:188
msgid "<b>Scrreprt:</b>  KOMA-Script replacement for the report class."
msgstr "<b>Scrreprt :</b>  Remplacement KOMA-Script de la classe report."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:189
msgid "<b>Scrbook:</b>  KOMA-Script replacement for the book class."
msgstr "<b>Scrbook :</b>  Remplacement KOMA-Script de la classe book."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:190
msgid "<b>Scrlttr2:</b>  KOMA-Script letter class with advanced features for address, date, and subject layout."
msgstr "<b>Scrlttr2 :</b>  Classe de lettres KOMA-Script avec des fonctionnalités avancées pour la mise en page de l'adresse, de la date et de l'objet."

