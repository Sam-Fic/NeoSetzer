msgid "Editor"
msgstr "Editor"

#: setzer/dialogs/preferences/pages/page_editor.py:560
msgid "Appearance"
msgstr "Aspetto"

#: setzer/dialogs/preferences/pages/page_editor.py:594
msgid "Font"
msgstr "Carattere"

#: setzer/dialogs/preferences/pages/page_editor.py:599
msgid "Use the system fixed width font"
msgstr "Usa il carattere a larghezza fissa di sistema"

#: setzer/dialogs/preferences/pages/page_editor.py:602
msgid ""
"Use the system fixed-width font for editing. When enabled, the font set "
"below is overridden."
msgstr "Usa il font monospaziato di sistema per la modifica. Quando abilitato, il font impostato qui sotto viene sovrascritto."

