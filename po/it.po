msgstr "Scegli un font personalizzato per l'editor LaTeX. Attivo solo quando \"Usa il font monospaziato di sistema\" è disattivato."

#: setzer/dialogs/preferences/pages/page_editor.py:617
msgid "Line Spacing"
msgstr "Interlinea"

#: setzer/dialogs/preferences/pages/page_editor.py:618
msgid "Extra vertical space between lines in pixels."
msgstr "Spazio verticale aggiuntivo tra le righe in pixel."

#: setzer/dialogs/preferences/pages/page_editor.py:620
msgid ""
"Extra vertical space between lines, in pixels. Affects readability and line "
"density in the editor."
msgstr "Spazio verticale aggiuntivo tra le righe, in pixel. Influisce sulla leggibilità e sulla densità delle righe nell'editor."

#: setzer/dialogs/preferences/pages/page_editor.py:627
msgid "Tab Stops"
msgstr "Tab stops"

#: setzer/dialogs/preferences/pages/page_editor.py:631
msgid "Insert spaces instead of tabs"
msgstr "Inserisci spazi anziché tabs"

#: setzer/dialogs/preferences/pages/page_editor.py:632
msgid "Use spaces when pressing Tab, instead of a tab character."
msgstr "Usa spazi quando premi Tab invece di un carattere di tabulazione."

#: setzer/dialogs/preferences/pages/page_editor.py:634
msgid "When enabled, pressing Tab inserts spaces instead of a tab character."
msgstr "Se abilitato, premendo Tab vengono inseriti spazi invece di un carattere di tabulazione."

#: setzer/dialogs/preferences/pages/page_editor.py:638
