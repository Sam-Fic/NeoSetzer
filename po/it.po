"Number of spaces a tab character occupies when \"Insert spaces instead of "
"tabs\" is enabled."
msgstr "Numero di spazi che corrispondono a un carattere di tabulazione quando \"Inserisci spazi invece dei tab\" è abilitato."

#: setzer/dialogs/preferences/pages/page_editor.py:654
msgid "Maximum undo depth"
msgstr "Profondità massima dell'annullamento"

#: setzer/dialogs/preferences/pages/page_editor.py:655
msgid "Maximum number of undo steps. 0 = unlimited."
msgstr "Numero massimo di operazioni annullabili. 0 = illimitato."

#: setzer/dialogs/preferences/pages/page_editor.py:657
msgid ""
"Limit the number of undoable actions kept in memory. Lower values save "
"memory for very large documents. 0 keeps an unlimited history."
msgstr "Limita il numero di azioni annullabili mantenute in memoria. Valori più bassi risparmiano memoria per documenti molto grandi. 0 mantiene una cronologia illimitata."

#: setzer/dialogs/preferences/pages/page_editor.py:665
msgid "Line Numbers"
msgstr "Numero linee"

#: setzer/dialogs/preferences/pages/page_editor.py:669
msgid "Show line numbers"
msgstr "Mostra numero linee"

#: setzer/dialogs/preferences/pages/page_editor.py:670
msgid "Display line numbers in the editor gutter."
msgstr "Mostra i numeri di riga nel margine dell'editor."

#: setzer/dialogs/preferences/pages/page_editor.py:672
msgid "Display line numbers in the left gutter of the editor."
msgstr "Mostra i numeri di riga nel margine sinistro dell'editor."

#: setzer/dialogs/preferences/pages/page_editor.py:676
msgid "Right Margin"
msgstr "Margine destro"

#: setzer/dialogs/preferences/pages/page_editor.py:680
msgid "Show right margin guide"
msgstr "Mostra la guida del margine destro"

#: setzer/dialogs/preferences/pages/page_editor.py:681
msgid "Display a vertical line at a fixed column."
msgstr "Mostra una linea verticale in una colonna fissa."

#: setzer/dialogs/preferences/pages/page_editor.py:683
msgid ""
"Display a vertical line at a fixed column position to help keep lines within "
"a recommended width."
msgstr "Mostra una linea verticale in una posizione di colonna fissa per aiutare a mantenere le righe entro una larghezza consigliata."

#: setzer/dialogs/preferences/pages/page_editor.py:688
msgid "Right margin column"
msgstr "Colonna del margine destro"

#: setzer/dialogs/preferences/pages/page_editor.py:689
msgid "Column position for the right margin guide."
msgstr "Posizione della colonna per la guida del margine destro."

#: setzer/dialogs/preferences/pages/page_editor.py:691
msgid ""
"Column position for the right margin guide vertical line. LaTeX documents "
"are typically kept within 80 columns."
msgstr "Posizione della colonna per la linea verticale della guida del margine destro. I documenti LaTeX sono solitamente mantenuti entro 80 colonne."

#: setzer/dialogs/preferences/pages/page_editor.py:698
msgid "Shortcuts Bar"
msgstr "Barra delle scorciatoie"

#: setzer/dialogs/preferences/pages/page_editor.py:702
msgid "Show shortcuts bar"
msgstr "Mostra la barra delle scorciatoie"

#: setzer/dialogs/preferences/pages/page_editor.py:703
msgid "Display the shortcuts bar above the editor."
msgstr "Visualizza la barra delle scorciatoie sopra l'editor."

#: setzer/dialogs/preferences/pages/page_editor.py:705
msgid "Display a bar of keyboard shortcuts above the editor."
msgstr "Mostra una barra di scorciatoie da tastiera sopra l'editor."

#: setzer/dialogs/preferences/pages/page_editor.py:709
msgid "Line Wrapping"
msgstr "Ritorno a capo automatico"

#: setzer/dialogs/preferences/pages/page_editor.py:713
msgid "Enable line wrapping"
msgstr "Abilita ritorno a capo automatico"

#: setzer/dialogs/preferences/pages/page_editor.py:714
msgid "Wrap long lines instead of scrolling horizontally."
msgstr "Mandare a capo le righe lunghe anziché scorrere orizzontalmente."

#: setzer/dialogs/preferences/pages/page_editor.py:716
msgid ""
"Wrap long lines to fit within the editor window instead of scrolling "
"horizontally."
msgstr "Mandare a capo le righe lunghe per adattarle alla finestra dell'editor invece di scorrere orizzontalmente."

#: setzer/dialogs/preferences/pages/page_editor.py:721
msgid "Code Folding"
msgstr "Comprimi codice"

#: setzer/dialogs/preferences/pages/page_editor.py:725
msgid "Enable code folding"
msgstr "Attiva compressione codice"

#: setzer/dialogs/preferences/pages/page_editor.py:726
msgid "Allow collapsing blocks of code such as environments."
msgstr "Consenti di comprimere i blocchi di codice, ad esempio gli ambienti."

#: setzer/dialogs/preferences/pages/page_editor.py:728
msgid ""
"Allow collapsing and expanding code blocks such as LaTeX environments, "
"sections, and functions."
msgstr "Consenti di comprimere ed espandere blocchi di codice come ambienti LaTeX, sezioni e funzioni."

#: setzer/dialogs/preferences/pages/page_editor.py:733
msgid "Sticky Scroll"
msgstr "Scorrimento aderente"

#: setzer/dialogs/preferences/pages/page_editor.py:737
msgid "Enable sticky scroll for sections"
msgstr "Abilita lo scorrimento aderente per le sezioni"

#: setzer/dialogs/preferences/pages/page_editor.py:738
msgid ""
"Show the current section header at the top of the editor while scrolling."
msgstr "Mostra l'intestazione della sezione corrente in cima all'editor durante lo scorrimento."

#: setzer/dialogs/preferences/pages/page_editor.py:740
msgid ""
"Displays a sticky header at the top of the editor showing the current "
"section hierarchy (chapter, section, subsection, etc.) as you scroll through "
"long documents."
msgstr "Mostra un'intestazione fissa in cima all'editor che visualizza la gerarchia della sezione corrente (capitolo, sezione, sottosezione, ecc.) mentre scorri documenti lunghi."

#: setzer/dialogs/preferences/pages/page_editor.py:746
msgid "Highlighting"
msgstr "Evidenziazione"

#: setzer/dialogs/preferences/pages/page_editor.py:750
msgid "Highlight current line"
msgstr "Evidenzia linea corrente"

#: setzer/dialogs/preferences/pages/page_editor.py:751
msgid "Visually emphasize the line containing the cursor."
msgstr "Evidenzia visivamente la riga che contiene il cursore."

#: setzer/dialogs/preferences/pages/page_editor.py:753
msgid "Visually highlight the line where the cursor is located."
msgstr "Evidenzia visivamente la riga in cui si trova il cursore."

#: setzer/dialogs/preferences/pages/page_editor.py:757
msgid "Highlight matching brackets"
msgstr "Evidenzia parentesi abbinate"

#: setzer/dialogs/preferences/pages/page_editor.py:758
msgid "Highlight the bracket matching the one next to the cursor."
msgstr "Evidenzia la parentesi corrispondente a quella accanto al cursore."

#: setzer/dialogs/preferences/pages/page_editor.py:760
msgid "Highlight the bracket that matches the one next to the cursor."
msgstr "Evidenzia la parentesi che corrisponde a quella accanto al cursore."

#: setzer/dialogs/preferences/pages/page_editor.py:764
msgid "Highlight matching \\begin/\\end"
msgstr "Evidenzia le coppie \\begin/\\end corrispondenti"

#: setzer/dialogs/preferences/pages/page_editor.py:765
msgid ""
"Highlight the environment matching the \\begin or \\end command next to the "
"cursor."
msgstr "Evidenzia l'ambiente che corrisponde al comando \\begin o \\end accanto al cursore."

#: setzer/dialogs/preferences/pages/page_editor.py:767
msgid ""
"Highlight the \\begin{...}/\\end{...} pair that matches the one next to the "
"cursor."
msgstr "Evidenzia la coppia \\begin{...}/\\end{...} che corrisponde a quella accanto al cursore."

#: setzer/dialogs/preferences/pages/page_editor.py:772
msgid "Visible Characters"
msgstr "Caratteri visibili"

#: setzer/dialogs/preferences/pages/page_editor.py:776
msgid "Show line endings"
msgstr "Mostra i terminatori di riga"

#: setzer/dialogs/preferences/pages/page_editor.py:777
msgid "Display line ending characters (¶) at the end of each line."
msgstr "Mostra i caratteri di fine riga (¶) alla fine di ogni riga."

#: setzer/dialogs/preferences/pages/page_editor.py:779
msgid ""
"Display a paragraph symbol (¶) at the end of each line to help identify "
"trailing whitespace and line ending issues."
msgstr "Mostra il simbolo di paragrafo (¶) alla fine di ogni riga per aiutare a individuare gli spazi bianchi finali e i problemi con i terminatori di riga."

#: setzer/dialogs/preferences/pages/page_editor.py:784
msgid "Show whitespace"
msgstr "Mostra gli spazi bianchi"

#: setzer/dialogs/preferences/pages/page_editor.py:785
msgid "Display whitespace characters (· for spaces, → for tabs)."
msgstr "Mostra i caratteri degli spazi bianchi (· per gli spazi, → per le tabulazioni)."

#: setzer/dialogs/preferences/pages/page_editor.py:787
msgid ""
"Display symbols for spaces (·) and tabs (→) to help debug indentation and "
"trailing whitespace issues."
msgstr "Mostra simboli per spazi (·) e tabulazioni (→) per aiutare a individuare problemi di indentazione e spazi bianchi finali."

#: setzer/dialogs/preferences/pages/page_editor.py:794
msgid "Auto Save"
msgstr "Salvataggio automatico"

#: setzer/dialogs/preferences/pages/page_editor.py:798
msgid "Enable auto save (crash recovery)"
msgstr "Abilita il salvataggio automatico (recupero dopo arresto anomalo)"

#: setzer/dialogs/preferences/pages/page_editor.py:799
msgid "Periodically save buffer to a temp file for crash recovery"
msgstr ""
"Salva periodicamente il buffer in un file temporaneo per il recupero dopo "
"arresto anomalo"

#: setzer/dialogs/preferences/pages/page_editor.py:801
msgid ""
"Periodically save the buffer to a temporary file for crash recovery. Setzer "
"can restore unsaved edits after an unexpected application exit."
msgstr "Salva periodicamente il buffer in un file temporaneo per il recupero dopo un crash. Setzer può ripristinare le modifiche non salvate dopo una chiusura imprevista dell'applicazione."

#: setzer/dialogs/preferences/pages/page_editor.py:807
msgid "Auto save interval (seconds)"
msgstr "Intervallo di salvataggio automatico (secondi)"

#: setzer/dialogs/preferences/pages/page_editor.py:811
msgid ""
"Time interval in seconds between automatic saves when auto save is enabled."
msgstr "Intervallo in secondi tra i salvataggi automatici quando il salvataggio automatico è attivato."

#: setzer/dialogs/preferences/pages/page_editor.py:817
msgid "External Changes"
msgstr "Modifiche esterne"

#: setzer/dialogs/preferences/pages/page_editor.py:821
msgid "Automatically reload changed files"
msgstr "Ricarica automaticamente i file modificati"

#: setzer/dialogs/preferences/pages/page_editor.py:823
msgid "Reload files modified by external applications without prompting"
msgstr ""
"Ricarica i file modificati da applicazioni esterne senza chiedere conferma"

#: setzer/dialogs/preferences/pages/page_editor.py:825
