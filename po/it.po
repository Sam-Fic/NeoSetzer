#: data/resources/latexdb/packages/general.xml:8
msgid "bibliographies in LaTeX."
msgstr "bibliografie in LaTeX."

#: data/resources/latexdb/packages/general.xml:9
msgid "simple arithmetic in LaTeX commands."
msgstr "aritmetica semplice nei comandi LaTeX."

#: data/resources/latexdb/packages/general.xml:10
msgid "foreground and background colors."
msgstr "colori di primo piano e di sfondo."

#: data/resources/latexdb/packages/general.xml:11
msgid "colored tables."
msgstr "tabelle colorate."

#: data/resources/latexdb/packages/general.xml:12
msgid "enumerate with redefinable labels."
msgstr "enumerate con etichette ridefinibili."

#: data/resources/latexdb/packages/general.xml:13
