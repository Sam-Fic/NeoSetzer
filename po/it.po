msgstr "Impostazioni proiezione"

#: setzer/dialogs/document_wizard/pages/page_beamer_settings.py:147
#: setzer/dialogs/document_wizard/pages/page_letter_settings.py:181
#: setzer/dialogs/preferences/pages/page_build_system.py:490
#: setzer/dialogs/document_wizard/pages/page_standard_settings.py:158
msgid "Options"
msgstr "Opzioni"

#: setzer/dialogs/document_wizard/pages/page_beamer_settings.py:149
msgid "Show navigation buttons"
msgstr "Mostra bottoni di navigazione"

#: setzer/dialogs/document_wizard/pages/page_beamer_settings.py:151
msgid ""
"Show or hide the Beamer navigation bar at the bottom of slides. Disabling "
"gives a cleaner look for presentations."
msgstr "Mostra o nascondi la barra di navigazione di Beamer nella parte inferiore delle diapositive. Disabilitandola si ottiene un aspetto più pulito per le presentazioni."

#: setzer/dialogs/document_wizard/pages/page_beamer_settings.py:154
msgid "Align content to the top of pages"
msgstr "Allinea il contenuto nella parte superiore delle pagine"

#: setzer/dialogs/document_wizard/pages/page_beamer_settings.py:155
msgid "(\"t\" option, it's centered by default)"
msgstr "(opzione \"t\", è centrata per impostazione predefinita)"

#: setzer/dialogs/document_wizard/pages/page_beamer_settings.py:157
msgid ""
"When enabled, slide content is top-aligned (the [t] option). When disabled, "
"content is vertically centered — the Beamer default."
msgstr "Se abilitato, il contenuto delle diapositive è allineato in alto (opzione [t]). Se disabilitato, il contenuto è centrato verticalmente — comportamento predefinito di Beamer."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:77
msgid "Choose a document class"
msgstr "Scegli classe del documento"

#: setzer/dialogs/document_wizard/pages/page_document_class.py:97
msgid ""
"<b>Article:</b>  For articles in scientific journals, term papers, handouts, "
"short reports, …\n"
"\n"
"This class on its own is pretty simplistic and is often used as a starting "
"point for more custom layouts."
msgstr ""
"<b>Articolo:</b>  Per articoli su riviste scientifiche, elaborati, dispense, "
"brevi relazioni, …\n"
"\n"
"Questa classe di per sé è piuttosto semplice e viene spesso usata come punto "
"di partenza per layout più personalizzati."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:98
msgid "<b>Book:</b>  For actual books containing many chapters and sections."
msgstr "<b>Book:</b>  Per libri reali contenenti molti capitoli e sezioni."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:99
msgid ""
"<b>Report:</b>  For longer reports and articles containing more than one "
"chapter, small books, thesis."
msgstr ""
"<b>Relazione:</b>  Per relazioni più lunghe e articoli contenenti più di un "
"capitolo, libretti, tesi."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:100
msgid "<b>Letter:</b>  For writing letters."
msgstr "<b>Letter:</b>  Per scrivere lettere."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:101
msgid ""
"<b>Beamer:</b>  A class for making presentation slides with LaTeX.\n"
"\n"
"There are many predefined presentation styles."
msgstr ""
"<b>Beamer:</b>  Una classe per creare slide di presentazione con LaTeX.\n"
"\n"
"Sono disponibili molti stili di presentazione predefiniti."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:103
msgid ""
"<b>Scrartcl:</b>  KOMA-Script replacement for the article class. Adds many "
"customizations and sensible defaults."
msgstr ""
"<b>Scrartcl:</b> sostituto KOMA-Script della classe article. Aggiunge molte "
"personalizzazioni e valori predefiniti sensati."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:104
msgid "<b>Scrreprt:</b>  KOMA-Script replacement for the report class."
msgstr "<b>Scrreprt:</b> sostituto KOMA-Script della classe report."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:105
msgid "<b>Scrbook:</b>  KOMA-Script replacement for the book class."
msgstr "<b>Scrbook:</b> sostituto KOMA-Script della classe book."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:106
msgid ""
"<b>Scrlttr2:</b>  KOMA-Script letter class with advanced features for "
"address, date, and subject layout."
msgstr "<b>Scrlttr2:</b> Classe per lettere KOMA-Script con funzionalità avanzate per la disposizione di indirizzo, data e oggetto."

#: setzer/dialogs/document_wizard/pages/page_document_class.py:126
