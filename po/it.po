msgstr "Tasti usati per navigare e confermare all'interno del popup di completamento."

#: setzer/dialogs/preferences/pages/page_editor.py:890
msgid "Brackets and Blocks"
msgstr "Parentesi e blocchi"

#: setzer/dialogs/preferences/pages/page_editor.py:894
