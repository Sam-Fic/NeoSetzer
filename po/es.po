msgstr "Mostrar documentos abiertos"

#: setzer/dialogs/preferences/pages/page_shortcuts.py:120
msgid "Switch Document"
msgstr "Cambiar de documento"

#: setzer/dialogs/preferences/pages/page_shortcuts.py:121
msgid "Show Document Chooser"
msgstr "Mostrar selector de documentos"

#: setzer/dialogs/preferences/pages/page_shortcuts.py:129
msgid "Help"
msgstr "Ayuda"

#: setzer/dialogs/preferences/pages/page_shortcuts.py:130
#: setzer/workspace/sidebar/sidebar.py:82
msgid "Document Structure"
msgstr "Estructura del documento"

#: setzer/dialogs/preferences/pages/page_shortcuts.py:131
msgid "Symbols"
msgstr "Símbolos"

#: setzer/dialogs/preferences/pages/page_shortcuts.py:132
msgid "Save and Build"
msgstr "Guardar y compilar"

#: setzer/dialogs/preferences/pages/page_shortcuts.py:138
