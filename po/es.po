msgstr "Activar completamente \\write18{SHELL COMMAND}"

#: setzer/dialogs/preferences/pages/page_build_system.py:861
msgid "Personal TeX tree"
msgstr "Arbol TeX personal"

#: setzer/dialogs/preferences/pages/page_build_system.py:862
msgid "Directory with your own packages, classes and bibliography styles (kpathsea TEXMFHOME). Applied to every build; leave empty to use your environment or the TeX Live default (~/texmf)."
msgstr "Directorio con sus propios paquetes, clases y estilos de bibliografia (kpathsea TEXMFHOME). Se aplica a cada compilacion; dejelo vacio para usar su entorno o el valor predeterminado de TeX Live (~/texmf)."

#: setzer/dialogs/preferences/pages/page_build_system.py:866
