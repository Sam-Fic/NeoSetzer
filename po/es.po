#: setzer/dialogs/preferences/pages/page_editor.py:773
msgid "Use spaces when pressing Tab, instead of a tab character."
msgstr "Usar espacios al pulsar Tab, en lugar de un carácter de tabulación."

#: setzer/dialogs/preferences/pages/page_editor.py:775
msgid "When enabled, pressing Tab inserts spaces instead of a tab character."
msgstr ""
"Cuando está activado, al pulsar Tab se insertan espacios en lugar de un "
"carácter de tabulación."

#: setzer/dialogs/preferences/pages/page_editor.py:783
msgid ""
"Number of spaces a tab character occupies when \"Insert spaces instead of "
"tabs\" is enabled."
msgstr ""
"Número de espacios que ocupa un carácter de tabulación cuando \"Insertar "
"espacios en lugar de tabulaciones\" está activado."

#: setzer/dialogs/preferences/pages/page_editor.py:795
msgid "Maximum undo depth"
msgstr "Profundidad máxima de deshacer"

#: setzer/dialogs/preferences/pages/page_editor.py:796
msgid "Maximum number of undo steps. 0 = unlimited."
msgstr "Número máximo de pasos de deshacer. 0 = ilimitado."

#: setzer/dialogs/preferences/pages/page_editor.py:798
msgid ""
"Limit the number of undoable actions kept in memory. Lower values save "
"memory for very large documents. 0 keeps an unlimited history."
msgstr ""
"Limita el número de acciones deshacer guardadas en memoria. Valores más "
"bajos ahorran memoria para documentos muy grandes. 0 mantiene un historial "
"ilimitado."

#: setzer/dialogs/preferences/pages/page_editor.py:806
msgid "Line Numbers"
msgstr "Números de línea"

#: setzer/dialogs/preferences/pages/page_editor.py:810
msgid "Show line numbers"
msgstr "Mostrar números de línea"

#: setzer/dialogs/preferences/pages/page_editor.py:811
msgid "Display line numbers in the editor gutter."
msgstr "Mostrar números de línea en el margen del editor."

#: setzer/dialogs/preferences/pages/page_editor.py:813
msgid "Display line numbers in the left gutter of the editor."
msgstr "Mostrar números de línea en el margen izquierdo del editor."

#: setzer/dialogs/preferences/pages/page_editor.py:817
msgid "Right Margin"
msgstr "Margen derecho"

#: setzer/dialogs/preferences/pages/page_editor.py:821
msgid "Show right margin guide"
msgstr "Mostrar guía del margen derecho"

#: setzer/dialogs/preferences/pages/page_editor.py:822
msgid "Display a vertical line at a fixed column."
msgstr "Mostrar una línea vertical en una columna fija."

#: setzer/dialogs/preferences/pages/page_editor.py:824
msgid ""
"Display a vertical line at a fixed column position to help keep lines within"
" a recommended width."
msgstr ""
"Muestra una línea vertical en una posición de columna fija para ayudar a "
"mantener las líneas dentro de un ancho recomendado."

#: setzer/dialogs/preferences/pages/page_editor.py:829
msgid "Right margin column"
msgstr "Columna del margen derecho"

#: setzer/dialogs/preferences/pages/page_editor.py:830
msgid "Column position for the right margin guide."
msgstr "Posición de columna para la guía del margen derecho."

#: setzer/dialogs/preferences/pages/page_editor.py:832
msgid ""
"Column position for the right margin guide vertical line. LaTeX documents "
"are typically kept within 80 columns."
msgstr ""
"Posición de columna para la línea vertical de guía del margen derecho. Los "
"documentos de LaTeX normalmente se mantienen dentro de 80 columnas."

#: setzer/dialogs/preferences/pages/page_editor.py:839
msgid "Shortcuts Bar"
msgstr "Barra de accesos directos"

#: setzer/dialogs/preferences/pages/page_editor.py:843
msgid "Show shortcuts bar"
msgstr "Mostrar la barra de accesos directos"

#: setzer/dialogs/preferences/pages/page_editor.py:844
msgid "Display the shortcuts bar above the editor."
msgstr "Mostrar la barra de atajos encima del editor."

#: setzer/dialogs/preferences/pages/page_editor.py:846
msgid "Display a bar of keyboard shortcuts above the editor."
msgstr "Mostrar una barra de atajos de teclado encima del editor."

#: setzer/dialogs/preferences/pages/page_editor.py:850
msgid "Line Wrapping"
msgstr "Ajuste de línea"

#: setzer/dialogs/preferences/pages/page_editor.py:854
msgid "Enable line wrapping"
msgstr "Activar el ajuste de línea"

#: setzer/dialogs/preferences/pages/page_editor.py:855
msgid "Wrap long lines instead of scrolling horizontally."
msgstr "Ajustar líneas largas en lugar de desplazarse horizontalmente."

#: setzer/dialogs/preferences/pages/page_editor.py:857
msgid ""
"Wrap long lines to fit within the editor window instead of scrolling "
"horizontally."
msgstr ""
"Ajusta las líneas largas para que quepan en la ventana del editor en lugar "
"de desplazarse horizontalmente."

#: setzer/dialogs/preferences/pages/page_editor.py:862
msgid "Code Folding"
msgstr "Plegado de código"

#: setzer/dialogs/preferences/pages/page_editor.py:866
msgid "Enable code folding"
msgstr "Activar el plegado de código"

#: setzer/dialogs/preferences/pages/page_editor.py:867
msgid "Allow collapsing blocks of code such as environments."
msgstr "Permitir contraer bloques de código como entornos."

#: setzer/dialogs/preferences/pages/page_editor.py:869
msgid ""
"Allow collapsing and expanding code blocks such as LaTeX environments, "
"sections, and functions."
msgstr ""
"Permite contraer y expandir bloques de código como entornos de LaTeX, "
"secciones y funciones."

#: setzer/dialogs/preferences/pages/page_editor.py:874
msgid "Sticky Scroll"
msgstr "Desplazamiento fijo"

#: setzer/dialogs/preferences/pages/page_editor.py:878
msgid "Enable sticky scroll for sections"
msgstr "Activar desplazamiento fijo para secciones"

#: setzer/dialogs/preferences/pages/page_editor.py:879
msgid ""
"Show the current section header at the top of the editor while scrolling."
msgstr ""
"Mostrar la cabecera de la sección actual en la parte superior del editor "
"mientras se desplaza."

#: setzer/dialogs/preferences/pages/page_editor.py:881
msgid ""
"Displays a sticky header at the top of the editor showing the current "
"section hierarchy (chapter, section, subsection, etc.) as you scroll through"
" long documents."
msgstr ""
"Muestra una cabecera fija en la parte superior del editor que muestra la "
"jerarquía de secciones actual (capítulo, sección, subsección, etc.) mientras"
" te desplazas por documentos largos."

#: setzer/dialogs/preferences/pages/page_editor.py:887
msgid "Highlighting"
msgstr "Resaltado"

#: setzer/dialogs/preferences/pages/page_editor.py:891
msgid "Highlight current line"
msgstr "Resaltar línea actual"

#: setzer/dialogs/preferences/pages/page_editor.py:892
msgid "Visually emphasize the line containing the cursor."
msgstr "Resaltar visualmente la línea que contiene el cursor."

#: setzer/dialogs/preferences/pages/page_editor.py:894
msgid "Visually highlight the line where the cursor is located."
msgstr "Resaltar visualmente la línea donde se encuentra el cursor."

#: setzer/dialogs/preferences/pages/page_editor.py:898
msgid "Highlight matching brackets"
msgstr "Resaltar corchetes coincidentes"

#: setzer/dialogs/preferences/pages/page_editor.py:899
msgid "Highlight the bracket matching the one next to the cursor."
msgstr "Resaltar el corchete que coincide con el que está al lado del cursor."

#: setzer/dialogs/preferences/pages/page_editor.py:901
msgid "Highlight the bracket that matches the one next to the cursor."
msgstr "Resaltar el corchete que coincide con el que está al lado del cursor."

#: setzer/dialogs/preferences/pages/page_editor.py:905
msgid "Highlight matching \\begin/\\end"
msgstr "Resaltar \\begin/\\end coincidentes"

#: setzer/dialogs/preferences/pages/page_editor.py:906
msgid ""
"Highlight the environment matching the \\begin or \\end command next to the "
"cursor."
msgstr ""
"Resalta el entorno que coincide con el comando \\begin o \\end junto al "
"cursor."

#: setzer/dialogs/preferences/pages/page_editor.py:908
msgid ""
"Highlight the \\begin{...}/\\end{...} pair that matches the one next to the "
"cursor."
msgstr ""
"Resalta el par \\begin{...}/\\end{...} que coincide con el que está junto al"
" cursor."

#: setzer/dialogs/preferences/pages/page_editor.py:913
msgid "Spell Checking"
msgstr "Corrección ortográfica"

#: setzer/dialogs/preferences/pages/page_editor.py:917
msgid "Check spelling as you type"
msgstr "Comprobar la ortografía mientras escribe"

#: setzer/dialogs/preferences/pages/page_editor.py:919
msgid ""
"Underline misspelled words in the text. Commands, math and verbatim regions "
"are skipped."
msgstr ""
"Subraya las palabras mal escritas en el texto. Se omiten comandos, "
"matemáticas y regiones verbatim."

#: setzer/dialogs/preferences/pages/page_editor.py:922
msgid ""
"Check spelling as you type using enchant/hunspell dictionaries. LaTeX "
"commands, math mode and verbatim environments are not checked. Right-click a"
" marked word for suggestions."
msgstr ""
"Comprueba la ortografía mientras escribe usando diccionarios "
"enchant/hunspell. No se comprueban los comandos de LaTeX, el modo matemático"
" ni los entornos verbatim. Haga clic derecho en una palabra marcada para ver"
" sugerencias."

#: setzer/dialogs/preferences/pages/page_editor.py:929
msgid "Dictionary used for spell checking"
msgstr "Diccionario utilizado para la corrección ortográfica"

#: setzer/dialogs/preferences/pages/page_editor.py:931
msgid ""
"The dictionary language for spell checking. Additional languages can be "
"installed via hunspell/aspell packages."
msgstr ""
"El idioma del diccionario para la corrección ortográfica. Se pueden instalar"
" más idiomas mediante los paquetes hunspell/aspell."

#: setzer/dialogs/preferences/pages/page_editor.py:936
msgid "Manage Words"
msgstr "Gestionar palabras"

#: setzer/dialogs/preferences/pages/page_editor.py:938
msgid "View and edit ignored words and your user dictionary"
msgstr "Ver y editar las palabras ignoradas y su diccionario de usuario"

#: setzer/dialogs/preferences/pages/page_editor.py:940
msgid ""
"Manage the words you ignored for the current session and the words saved "
"permanently to your user dictionary."
msgstr ""
"Gestione las palabras que ignoró en la sesión actual y las palabras "
"guardadas permanentemente en su diccionario de usuario."

#: setzer/dialogs/preferences/pages/page_editor.py:950
msgid "Visible Characters"
msgstr "Caracteres visibles"

#: setzer/dialogs/preferences/pages/page_editor.py:954
msgid "Show line endings"
msgstr "Mostrar finales de línea"

#: setzer/dialogs/preferences/pages/page_editor.py:955
msgid "Display line ending characters (¶) at the end of each line."
msgstr "Mostrar caracteres de fin de línea (¶) al final de cada línea."

#: setzer/dialogs/preferences/pages/page_editor.py:957
msgid ""
"Display a paragraph symbol (¶) at the end of each line to help identify "
"trailing whitespace and line ending issues."
msgstr ""
"Muestra un símbolo de párrafo (¶) al final de cada línea para ayudar a "
"identificar espacios en blanco finales y problemas de final de línea."

#: setzer/dialogs/preferences/pages/page_editor.py:962
msgid "Show whitespace"
msgstr "Mostrar espacios en blanco"

#: setzer/dialogs/preferences/pages/page_editor.py:963
msgid "Display whitespace characters (· for spaces, → for tabs)."
msgstr ""
"Mostrar caracteres de espacio en blanco (· para espacios, → para "
"tabulaciones)."

#: setzer/dialogs/preferences/pages/page_editor.py:965
msgid ""
"Display symbols for spaces (·) and tabs (→) to help debug indentation and "
"trailing whitespace issues."
msgstr ""
"Muestra símbolos para espacios (·) y tabulaciones (→) para ayudar a depurar "
"problemas de indentación y espacios en blanco finales."

#: setzer/dialogs/preferences/pages/page_editor.py:972
msgid "Auto Save"
msgstr "Guardado automático"

#: setzer/dialogs/preferences/pages/page_editor.py:976
msgid "Enable auto save (crash recovery)"
msgstr "Activar el guardado automático (recuperación ante fallos)"

#: setzer/dialogs/preferences/pages/page_editor.py:977
msgid "Periodically save buffer to a temp file for crash recovery"
msgstr ""
"Guardar periódicamente el búfer en un archivo temporal para la recuperación "
"ante fallos"

#: setzer/dialogs/preferences/pages/page_editor.py:979
msgid ""
"Periodically save the buffer to a temporary file for crash recovery. Setzer "
"can restore unsaved edits after an unexpected application exit."
msgstr ""
"Guarda periódicamente el búfer en un archivo temporal para recuperación de "
"fallos. Setzer puede restaurar ediciones no guardadas después de una salida "
"inesperada de la aplicación."

#: setzer/dialogs/preferences/pages/page_editor.py:985
msgid "Auto save interval (seconds)"
msgstr "Intervalo de guardado automático (segundos)"

#: setzer/dialogs/preferences/pages/page_editor.py:989
msgid ""
"Time interval in seconds between automatic saves when auto save is enabled."
msgstr ""
"Intervalo de tiempo en segundos entre guardados automáticos cuando el "
"guardado automático está activado."

#: setzer/dialogs/preferences/pages/page_editor.py:995
msgid "External Changes"
msgstr "Cambios externos"

#: setzer/dialogs/preferences/pages/page_editor.py:999
msgid "Automatically reload changed files"
msgstr "Recargar automáticamente los archivos modificados"

#: setzer/dialogs/preferences/pages/page_editor.py:1001
msgid "Reload files modified by external applications without prompting"
msgstr "Recargar archivos modificados por aplicaciones externas sin preguntar"

#: setzer/dialogs/preferences/pages/page_editor.py:1003
msgid ""
"Automatically reload files modified by external applications without showing"
" a prompt. Unsaved changes in the editor will be lost."
msgstr ""
"Recargar automáticamente los archivos modificados por aplicaciones externas "
"sin mostrar un aviso. Se perderán los cambios no guardados en el editor."

#: setzer/dialogs/preferences/pages/page_editor.py:1009
#: setzer/dialogs/preferences/pages/page_shortcuts.py:111
#: setzer/workspace/shortcutsbar/shortcutsbar_viewgtk.py:391
msgid "New Document"
msgstr "Nuevo documento"

#: setzer/dialogs/preferences/pages/page_editor.py:1013
msgid "Default Encoding"
msgstr "Codificación predeterminada"

#: setzer/dialogs/preferences/pages/page_editor.py:1015
msgid "Encoding used when creating new documents"
msgstr "Codificación utilizada al crear documentos nuevos"

#: setzer/dialogs/preferences/pages/page_editor.py:1017
msgid ""
"Default character encoding for new documents. UTF-8 is the recommended "
"choice for cross-platform collaboration."
msgstr ""
"Codificación de caracteres predeterminada para nuevos documentos. UTF-8 es "
"la opción recomendada para colaboración multiplataforma."

#: setzer/dialogs/preferences/pages/page_editor.py:1020
msgid "UTF-8"
msgstr "UTF-8"

#: setzer/dialogs/preferences/pages/page_editor.py:1021
msgid "ISO-8859-1"
msgstr "ISO-8859-1"

#: setzer/dialogs/preferences/pages/page_editor.py:1022
msgid "Windows-1252"
msgstr "Windows-1252"

#: setzer/dialogs/preferences/pages/page_editor.py:1023
msgid "UTF-16"
msgstr "UTF-16"

#: setzer/dialogs/preferences/pages/page_editor.py:1029
msgid "Default Line Ending"
msgstr "Final de línea predeterminado"

#: setzer/dialogs/preferences/pages/page_editor.py:1031
msgid "Line ending format for new documents"
msgstr "Formato de fin de línea para nuevos documentos"

#: setzer/dialogs/preferences/pages/page_editor.py:1033
msgid ""
"Default line ending format for new documents. LF is Unix/macOS style; CRLF "
"is Windows style; CR is old macOS style."
msgstr ""
"Formato de final de línea predeterminado para nuevos documentos. LF es "
"estilo Unix/macOS; CRLF es estilo Windows; CR es estilo antiguo de macOS."

#: setzer/dialogs/preferences/pages/page_editor.py:1036
msgid "LF (Unix)"
msgstr "LF (Unix)"

#: setzer/dialogs/preferences/pages/page_editor.py:1037
msgid "CRLF (Windows)"
msgstr "CRLF (Windows)"

#: setzer/dialogs/preferences/pages/page_editor.py:1038
msgid "CR (Old macOS)"
msgstr "CR (macOS antiguo)"

#: setzer/dialogs/preferences/pages/page_editor.py:1045
msgid "Autocomplete"
msgstr "Autocompletado"

#: setzer/dialogs/preferences/pages/page_editor.py:1049
msgid "Suggest matching LaTeX Commands"
msgstr "Sugerir comandos LaTeX coincidentes"

#: setzer/dialogs/preferences/pages/page_editor.py:1050
msgid "Show a completion popup as you type LaTeX commands."
msgstr ""
"Mostrar un menú emergente de completado mientras escribes comandos LaTeX."

#: setzer/dialogs/preferences/pages/page_editor.py:1054
msgid "Manual trigger key"
msgstr "Tecla de activación manual"

#: setzer/dialogs/preferences/pages/page_editor.py:1055
msgid "Press to capture a shortcut that opens the completion popup."
msgstr ""
"Pulsa para capturar un atajo que abre el menú emergente de completado."

#: setzer/dialogs/preferences/pages/page_editor.py:1062
msgid "Completion Navigation"
msgstr "Navegación de finalización"

#: setzer/dialogs/preferences/pages/page_editor.py:1063
msgid "Keys used to move and confirm within the completion popup."
msgstr ""
"Teclas usadas para moverse y confirmar dentro del menú emergente de "
"completado."

#: setzer/dialogs/preferences/pages/page_editor.py:1074
msgid "Brackets and Blocks"
msgstr "Paréntesis y bloques"

#: setzer/dialogs/preferences/pages/page_editor.py:1078
msgid "Automatically add closing brackets"
msgstr "Añadir automáticamente los paréntesis de cierre"

#: setzer/dialogs/preferences/pages/page_editor.py:1079
msgid "Insert a matching closing bracket when you type an opening one."
msgstr ""
"Insertar un corchete de cierre coincidente cuando escribes uno de apertura."

#: setzer/dialogs/preferences/pages/page_editor.py:1083
msgid "Add brackets to selected text, instead of replacing it with them"
msgstr ""
"Añadir paréntesis al texto seleccionado, en lugar de reemplazarlo con ellos"

#: setzer/dialogs/preferences/pages/page_editor.py:1084
msgid "Wrap the selected text in brackets, keeping it selected."
msgstr ""
"Envolver el texto seleccionado en corchetes, manteniéndolo seleccionado."

#: setzer/dialogs/preferences/pages/page_editor.py:1088
msgid "Jump over closing brackets with Tab"
msgstr "Saltar los paréntesis de cierre con Tab"

#: setzer/dialogs/preferences/pages/page_editor.py:1089
msgid "Press Tab to move past an automatically inserted closing bracket."
msgstr ""
"Pulse Tab para avanzar más allá de un corchete de cierre insertado "
"automáticamente."

#: setzer/dialogs/preferences/pages/page_editor.py:1093
msgid "Update matching begin / end blocks"
msgstr "Actualizar los bloques begin / end coincidentes"

#: setzer/dialogs/preferences/pages/page_editor.py:1094
msgid "Keep matching \\begin{} / \\end{} blocks in sync when you edit one."
msgstr ""
"Mantén sincronizados los bloques \\begin{} / \\end{} coincidentes cuando "
"edites uno."

#: setzer/dialogs/preferences/pages/page_editor.py:1098
msgid "Automatically add matching \\end{}"
msgstr "Añadir automáticamente el \\end{} coincidente"

#: setzer/dialogs/preferences/pages/page_editor.py:1099
msgid ""
"When you type \\begin{, automatically insert the matching \\end{} (use Tab "
"to jump to the content placeholder)."
msgstr ""
"Cuando escribas \\begin{, inserta automáticamente el \\end{} coincidente "
"(usa Tab para saltar al marcador de posición del contenido)."

#: setzer/dialogs/preferences/pages/page_editor.py:1104
msgid "Experimental Features"
msgstr "Características experimentales"

#: setzer/dialogs/preferences/pages/page_editor.py:1106
msgid "Unstable multi-cursor editing features."
msgstr "Funciones de edición con múltiples cursores inestables."

#: setzer/dialogs/preferences/pages/page_editor.py:1110
msgid "Enable experimental features"
msgstr "Activar características experimentales"

#: setzer/dialogs/preferences/pages/page_editor.py:1112
msgid "Master switch for all multi-cursor features below."
msgstr ""
"Interruptor maestro para todas las funciones de múltiples cursores "
"siguientes."

#: setzer/dialogs/preferences/pages/page_editor.py:1116
msgid "Multi-Cursor Settings"
msgstr "Configuración de múltiples cursores"

#: setzer/dialogs/preferences/pages/page_editor.py:1118
msgid "Individually enable or disable each multi-cursor feature."
msgstr ""
"Activa o desactiva individualmente cada función de múltiples cursores."

#: setzer/dialogs/preferences/pages/page_editor.py:1122
msgid "Multi-cursor mode"
msgstr "Modo de múltiples cursores"

#: setzer/dialogs/preferences/pages/page_editor.py:1124
msgid "Allow creating additional cursors."
msgstr "Permitir crear cursores adicionales."

#: setzer/dialogs/preferences/pages/page_editor.py:1128
msgid "Alt+Click to add/remove cursor"
msgstr "Alt+Clic para añadir/eliminar cursor"

#: setzer/dialogs/preferences/pages/page_editor.py:1130
msgid "Add a cursor at the clicked position, or remove an existing one."
msgstr "Añade un cursor en la posición clicada, o elimina uno existente."

#: setzer/dialogs/preferences/pages/page_editor.py:1134
msgid "Alt+Drag column selection"
msgstr "Alt+Arrastrar selección de columna"

#: setzer/dialogs/preferences/pages/page_editor.py:1136
msgid "Drag to create a column (rectangular) selection."
msgstr "Arrastra para crear una selección de columna (rectangular)."

#: setzer/dialogs/preferences/pages/page_editor.py:1140
msgid "Select next occurrence (Ctrl+D)"
msgstr "Seleccionar siguiente ocurrencia (Ctrl+D)"

#: setzer/dialogs/preferences/pages/page_editor.py:1142
msgid "Select the next match of the selected text or word."
msgstr ""
"Selecciona la siguiente coincidencia del texto o palabra seleccionada."

#: setzer/dialogs/preferences/pages/page_editor.py:1146
msgid "Select all occurrences (Ctrl+Shift+L)"
msgstr "Seleccionar todas las ocurrencias (Ctrl+Shift+L)"

#: setzer/dialogs/preferences/pages/page_editor.py:1148
msgid "Select all matches of the selected text or word."
msgstr "Selecciona todas las coincidencias del texto o palabra seleccionada."

#: setzer/dialogs/preferences/pages/page_editor.py:1152
msgid "Add cursor above (Ctrl+Alt+↑)"
msgstr "Añadir cursor arriba (Ctrl+Alt+↑)"

#: setzer/dialogs/preferences/pages/page_editor.py:1154
msgid "Add a cursor on the line above each existing cursor."
msgstr "Añade un cursor en la línea encima de cada cursor existente."

#: setzer/dialogs/preferences/pages/page_editor.py:1158
msgid "Add cursor below (Ctrl+Alt+↓)"
msgstr "Añadir cursor abajo (Ctrl+Alt+↓)"

#: setzer/dialogs/preferences/pages/page_editor.py:1160
msgid "Add a cursor on the line below each existing cursor."
msgstr "Añade un cursor en la línea debajo de cada cursor existente."

#: setzer/dialogs/preferences/pages/page_editor.py:1164
msgid "Escape to clear multi-cursor"
msgstr "Escape para limpiar múltiples cursores"

#: setzer/dialogs/preferences/pages/page_editor.py:1166
msgid "Press Escape to clear all additional cursors."
msgstr "Pulsa Escape para limpiar todos los cursores adicionales."

#: setzer/dialogs/preferences/pages/page_editor.py:1170
msgid "Multi-cursor text editing"
msgstr "Edición de texto con múltiples cursores"

#: setzer/dialogs/preferences/pages/page_editor.py:1172
msgid "Insert, delete, and indent at all cursor positions simultaneously."
msgstr ""
"Inserta, elimina e indenta en todas las posiciones de cursor "
"simultáneamente."

#: setzer/dialogs/preferences/pages/page_shortcuts.py:117
#: setzer/popovers/hamburger_menu/hamburger_menu.py:148
