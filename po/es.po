#: data/resources/latexdb/packages/general.xml:8
msgid "bibliographies in LaTeX."
msgstr "bibliografías en LaTeX."

#: data/resources/latexdb/packages/general.xml:9
msgid "simple arithmetic in LaTeX commands."
msgstr "aritmética simple en comandos LaTeX."

#: data/resources/latexdb/packages/general.xml:10
msgid "foreground and background colors."
msgstr "colores de primer plano y de fondo."

#: data/resources/latexdb/packages/general.xml:11
msgid "colored tables."
msgstr "tablas coloreadas."

#: data/resources/latexdb/packages/general.xml:12
msgid "enumerate with redefinable labels."
msgstr "enumerate con etiquetas redefinibles."

#: data/resources/latexdb/packages/general.xml:13
msgid "interface to document dimensions."
msgstr "interfaz con las dimensiones del documento."

#: data/resources/latexdb/packages/general.xml:14
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:191
msgid "create a glossary for your document."
msgstr "crea un glosario para su documento."

#: data/resources/latexdb/packages/general.xml:15
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:184
msgid "include graphics in your document."
msgstr "incluye gráficas en su documento."

#: data/resources/latexdb/packages/general.xml:16
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:188
msgid "create hyperlinks within your document."
msgstr "crea hipervínculos en su documento."

#: data/resources/latexdb/packages/general.xml:17
msgid "conditional commands."
msgstr "comandos condicionales."

#: data/resources/latexdb/packages/general.xml:18
msgid "provides a listing environment for embedding programming code."
msgstr "proporciona un entorno listing para incrustar código de programación."

#: data/resources/latexdb/packages/general.xml:19
msgid "provides additional bibliography and citation styles."
msgstr "proporciona estilos adicionales de bibliografía y de citas."

#: data/resources/latexdb/packages/general.xml:20
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:192
msgid "paragraphs without indentation."
msgstr "párrafos sin sangría."

#: data/resources/latexdb/packages/general.xml:21
msgid "create plots in two and three dimensions."
msgstr "crea gráficas en dos y tres dimensiones."

#: data/resources/latexdb/packages/general.xml:22
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:183
msgid "contains symbols to be used in textmode."
msgstr "contiene símbolos para usar en el modo texto."

#: data/resources/latexdb/packages/general.xml:23
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:189
msgid "define theorem environments (like \"definition\", \"lemma\", …) with custom styling."
msgstr "define entornos de teoremas (como \"definición\", \"lema\", …) con un estilo personalizado."

#: data/resources/latexdb/packages/general.xml:24
msgid "graphics and plotting."
msgstr "gráficos y trazado."

