msgstr "在補齊彈出視窗中將選取往下移一項。"

#: setzer/dialogs/preferences/pages/page_editor.py:299
msgid "Previous page"
msgstr "上一頁"

#: setzer/dialogs/preferences/pages/page_editor.py:300
msgid "Scroll the completion popup up one page."
msgstr "將補齊彈出視窗向上捲動一頁。"

#: setzer/dialogs/preferences/pages/page_editor.py:301
msgid "Next page"
msgstr "下一頁"

#: setzer/dialogs/preferences/pages/page_editor.py:302
msgid "Scroll the completion popup down one page."
msgstr "將補齊彈出視窗向下捲動一頁。"

#: setzer/dialogs/preferences/pages/page_editor.py:303
