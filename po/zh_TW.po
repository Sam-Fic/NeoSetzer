msgstr "在每行末端顯示行尾字元（¶）。"

#: setzer/dialogs/preferences/pages/page_editor.py:779
msgid ""
"Display a paragraph symbol (¶) at the end of each line to help identify "
"trailing whitespace and line ending issues."
msgstr "在每行末端顯示段落符號（¶），協助辨識行尾空白與換行問題。"

#: setzer/dialogs/preferences/pages/page_editor.py:784
msgid "Show whitespace"
msgstr "顯示空白字元"

#: setzer/dialogs/preferences/pages/page_editor.py:785
