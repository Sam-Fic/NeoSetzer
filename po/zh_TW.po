msgstr "高亮游標旁 \\begin 或 \\end 指令所對應的環境。"

#: setzer/dialogs/preferences/pages/page_editor.py:767
msgid ""
"Highlight the \\begin{...}/\\end{...} pair that matches the one next to the "
"cursor."
msgstr "高亮與游標旁相匹配的 \\begin{...}/\\end{...} 配對。"

#: setzer/dialogs/preferences/pages/page_editor.py:772
msgid "Visible Characters"
msgstr "可見字元"

#: setzer/dialogs/preferences/pages/page_editor.py:776
msgid "Show line endings"
msgstr "顯示行尾符號"

#: setzer/dialogs/preferences/pages/page_editor.py:777
