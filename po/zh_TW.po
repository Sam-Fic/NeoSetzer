msgstr "顯示右側邊界輔助線"

#: setzer/dialogs/preferences/pages/page_editor.py:681
msgid "Display a vertical line at a fixed column."
msgstr "在固定欄位顯示一條垂直線。"

#: setzer/dialogs/preferences/pages/page_editor.py:683
msgid ""
"Display a vertical line at a fixed column position to help keep lines within "
"a recommended width."
msgstr "在固定的欄位位置顯示一條垂直線，協助將每行控制在建議寬度內。"

#: setzer/dialogs/preferences/pages/page_editor.py:688
msgid "Right margin column"
msgstr "右側邊界欄位"

#: setzer/dialogs/preferences/pages/page_editor.py:689
msgid "Column position for the right margin guide."
msgstr "右側邊界輔助線的欄位位置。"

#: setzer/dialogs/preferences/pages/page_editor.py:691
msgid ""
"Column position for the right margin guide vertical line. LaTeX documents "
"are typically kept within 80 columns."
msgstr "右側邊界輔助線的欄位位置。LaTeX 文件通常建議控制在 80 欄以內。"

#: setzer/dialogs/preferences/pages/page_editor.py:698
msgid "Shortcuts Bar"
msgstr "快捷鍵列"

#: setzer/dialogs/preferences/pages/page_editor.py:702
msgid "Show shortcuts bar"
msgstr "顯示快捷鍵列"

#: setzer/dialogs/preferences/pages/page_editor.py:703
msgid "Display the shortcuts bar above the editor."
msgstr "在編輯器上方顯示快捷鍵列。"

#: setzer/dialogs/preferences/pages/page_editor.py:705
