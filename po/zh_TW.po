msgstr "在編輯器上方顯示一排鍵盤快捷鍵。"

#: setzer/dialogs/preferences/pages/page_editor.py:709
msgid "Line Wrapping"
msgstr "自動換行"

#: setzer/dialogs/preferences/pages/page_editor.py:713
