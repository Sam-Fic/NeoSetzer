msgstr "顯示空白字元（· 表示空格，→ 表示定位）。"

#: setzer/dialogs/preferences/pages/page_editor.py:787
msgid ""
"Display symbols for spaces (·) and tabs (→) to help debug indentation and "
"trailing whitespace issues."
msgstr "顯示空格（·）與定位鍵（→）符號，協助除錯縮排與行尾空白問題。"

#: setzer/dialogs/preferences/pages/page_editor.py:794
msgid "Auto Save"
msgstr "自動儲存"

#: setzer/dialogs/preferences/pages/page_editor.py:798
msgid "Enable auto save (crash recovery)"
msgstr "啟用自動儲存（當機復原）"

#: setzer/dialogs/preferences/pages/page_editor.py:799
msgid "Periodically save buffer to a temp file for crash recovery"
msgstr "定期將緩衝區儲存至暫存檔以供當機復原"

#: setzer/dialogs/preferences/pages/page_editor.py:801
