msgstr "備份與還原"

#: setzer/dialogs/preferences/pages/page_appearance.py:840
msgid "Export your preferences and keyboard shortcuts to a file, or import them on another machine."
msgstr "將您的偏好設定與鍵盤快捷鍵匯出至檔案，或在其他電腦上匯入。"

#: setzer/dialogs/preferences/pages/page_appearance.py:846 setzer/dialogs/preferences/pages/page_shortcuts.py:709
msgid "Export"
msgstr "匯出"

#: setzer/dialogs/preferences/pages/page_appearance.py:854 setzer/dialogs/preferences/pages/page_shortcuts.py:716
msgid "Import"
msgstr "匯入"

