msgid "Page format"
msgstr "頁面格式"

#: setzer/dialogs/document_wizard/pages/page.py:107
msgid ""
"Select the paper size for the document. US Letter for North America, A4 for "
"most other regions."
msgstr "選取文件的紙張尺寸。北美使用 US Letter，其他多數地區使用 A4。"

#: setzer/dialogs/document_wizard/pages/page.py:119
msgid "Landscape format"
msgstr "橫向"

#: setzer/dialogs/document_wizard/pages/page.py:121
msgid ""
"Switch to landscape orientation (wider than tall). Useful for wide tables or "
"figures."
msgstr "切換為橫向（寬大於高）。適用於寬表格或圖片。"

#: setzer/dialogs/document_wizard/pages/page.py:125
msgid "Two-column layout"
msgstr "雙欄版面配置"

#: setzer/dialogs/document_wizard/pages/page.py:127
msgid ""
"Arrange text in two columns per page. Common for scientific articles and "
"magazines."
msgstr "每頁將文字排成雙欄。常見於科學期刊文章與雜誌。"

#: setzer/dialogs/document_wizard/pages/page.py:135
#: setzer/dialogs/document_wizard/pages/page_letter_settings.py:186
#: setzer/dialogs/document_wizard/pages/page_standard_settings.py:163
msgid "Font size"
msgstr "字型大小"

#: setzer/dialogs/document_wizard/pages/page.py:138
msgid ""
"LaTeX standard default is 10pt; 12pt is common for book and letter. Values "
"outside 10-12pt require the extsizes package."
msgstr ""
"LaTeX 標準預設值為 10pt；book 與 letter 類別常用 12pt。10–12pt 以外的值需要使"
"用 extsizes 套件。"

#: setzer/dialogs/document_wizard/pages/page.py:143
msgid "Use default margins"
msgstr "使用預設邊界"

#: setzer/dialogs/document_wizard/pages/page.py:144
msgid "On: use LaTeX default margins. Off: set custom margins below."
msgstr "開：使用 LaTeX 預設邊界。關：在下方設定自訂邊界。"

#: setzer/dialogs/document_wizard/pages/page.py:146
msgid ""
"When enabled, LaTeX's default margins (about 1 inch / 2.54 cm) are used. "
"Disable to set custom values for each side."
msgstr ""
"啟用時，採用 LaTeX 的預設邊界（約 1 英吋 / 2.54 公分）。停用則可為各邊設定自"
"訂數值。"

#: setzer/dialogs/document_wizard/pages/page.py:149
#: setzer/dialogs/preferences/pages/page_shortcuts.py:165
msgid "Left"
msgstr "靠左"

#: setzer/dialogs/document_wizard/pages/page.py:150
#: setzer/dialogs/preferences/pages/page_shortcuts.py:166
msgid "Right"
msgstr "靠右"

#: setzer/dialogs/document_wizard/pages/page.py:151
msgid "Top"
msgstr "頂端"

