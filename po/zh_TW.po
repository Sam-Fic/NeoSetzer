#: setzer/dialogs/preferences/pages/page_build_system.py:570
msgid "recommended"
msgstr "建議"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:176
msgid "contains symbols to be used in textmode."
msgstr "包含用於文字模式的符號。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:177
msgid "include graphics in your document."
msgstr "在文件中包含圖形。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:178
msgid "foreground and background color."
msgstr "前景與背景顏色。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:179
msgid "enables colored text."
msgstr "啟用彩色文字。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:180
msgid "type urls with the \\url{..} command without escaping them."
msgstr "使用 \\url{..} 命令輸入網址，無需轉義。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:181
msgid "create hyperlinks within your document."
msgstr "在文件內建立超連結。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:182
msgid ""
"define theorem environments (like \"definition\", \"lemma\", …) with custom "
"styling."
msgstr "以自訂樣式定義定理環境（如「定義」、「引理」等）。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:183
msgid "provides the \\listing environment for embedding programming code."
msgstr "提供用於嵌入程式碼的 \\listing 環境。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:184
msgid "create a glossary for your document."
msgstr "為文件建立詞彙表。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:185
msgid "paragraphs without indentation."
msgstr "不縮排的段落。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:190
msgid "Document properties"
msgstr "文件屬性"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:193
#: setzer/popovers/shortcutsbar/document_menu.py:56
msgid "Title"
msgstr "標題"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:194
msgid "The document title, used in the \\title{} command."
msgstr "文件標題，用於 \\title{} 指令。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:196
#: setzer/popovers/shortcutsbar/document_menu.py:55
msgid "Author"
msgstr "作者"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:197
msgid "The document author, used in the \\author{} command."
msgstr "文件作者，用於 \\author{} 指令。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:199
#: setzer/popovers/shortcutsbar/document_menu.py:57
msgid "Date"
msgstr "日期"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:200
msgid ""
"The document date, used in the \\date{} command. Use \\\\today for the "
"current date."
msgstr "文件的日期，用於 \\date{} 指令。使用 \\\\today 表示目前日期。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:208
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:213
#: setzer/dialogs/preferences/pages/page_appearance.py:436
msgid "Language"
msgstr "語言"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:209
msgid ""
"The main language for this document. This is used to apply rules for "
"hyphenation and other purposes."
msgstr "此文件的主要語言。這會用於套用連字規則及其他用途。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:214
msgid ""
"The main language for hyphenation patterns and automatic labels (e.g. "
"\"Abstract\" vs \"Zusammenfassung\")."
msgstr ""
"主要語言，用於連字規則與自動標籤（例如「Abstract」與「Zusammenfassung」的差"
"異）。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:231
#: setzer/dialogs/document_wizard/pages/page_general_settings.py:234
msgid "Font package"
msgstr "字型套件"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:232
msgid ""
"Select the font package to include in the preamble. lmodern is recommended "
"for pdfLaTeX, fontspec for XeLaTeX/LuaLaTeX."
msgstr ""
"選取要加入前言的字形套件。pdfLaTeX 建議使用 lmodern，XeLaTeX/LuaLaTeX 則使用 "
"fontspec。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:236
msgid ""
"Choose the font package. lmodern (Latin Modern) is recommended for pdfLaTeX. "
"fontspec enables system fonts with XeLaTeX/LuaLaTeX."
msgstr ""
"選擇字形套件。pdfLaTeX 建議使用 lmodern（Latin Modern）；fontspec 可讓 "
"XeLaTeX/LuaLaTeX 使用系統字型。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:241
msgid "Latin Modern (lmodern)"
msgstr "拉丁現代字型 (lmodern)"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:242
msgid "Fontspec (for XeLaTeX/LuaLaTeX)"
msgstr "Fontspec（適用於 XeLaTeX/LuaLaTeX）"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:243
#: setzer/dialogs/document_wizard/pages/page_standard_settings.py:146
msgid "None"
msgstr "（無）"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:254
msgid "fontspec requires XeLaTeX or LuaLaTeX to compile; pdfLaTeX will fail."
msgstr "fontspec 需要 XeLaTeX 或 LuaLaTeX 才能編譯；pdfLaTeX 會失敗。"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:266
msgid "AMS math packages"
msgstr "AMS 數學套件"

#: setzer/dialogs/document_wizard/pages/page_general_settings.py:267
