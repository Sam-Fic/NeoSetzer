msgstr "啟用受限的 \\write18{SHELL COMMAND}"

#: setzer/dialogs/preferences/pages/page_build_system.py:851
msgid "Fully enable \\write18{SHELL COMMAND}"
msgstr "完全啟用 \\write18{SHELL COMMAND}"

#: setzer/dialogs/preferences/pages/page_build_system.py:858
msgid "Personal TeX tree"
msgstr "個人 TeX 目錄樹"

#: setzer/dialogs/preferences/pages/page_build_system.py:859
