msgid "Highlight matching brackets"
msgstr "突顯相符括號"

#: setzer/dialogs/preferences/pages/page_editor.py:758
msgid "Highlight the bracket matching the one next to the cursor."
msgstr "高亮與游標旁括號相符的括號。"

#: setzer/dialogs/preferences/pages/page_editor.py:760
msgid "Highlight the bracket that matches the one next to the cursor."
msgstr "高亮與游標旁括號相配的括號。"

