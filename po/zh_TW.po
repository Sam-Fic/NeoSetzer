msgstr "啟用後，按下 Tab 會插入空格而非定位字元。"

#: setzer/dialogs/preferences/pages/page_editor.py:638
#: setzer/dialogs/document_properties/document_properties_viewgtk.py:129
msgid "Tab Width"
msgstr "定位寬度"

#: setzer/dialogs/preferences/pages/page_editor.py:642
