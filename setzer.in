# pycairo 必须在 import gi 之前导入。PyGObject 的 cairo foreign struct
# converter（cairo.Context 跨 Python/C 边界编组）依赖 pycairo 的 C API 在
# gi 初始化时可用；若 gi 先导入，pycairo 尚未加载，cairo converter 注册会被
# 跳过，运行时 draw_func / page.render 偶发 "Couldn't find foreign struct
# converter for 'cairo.Context'" 导致预览空白。提前 import cairo 让 PyGObject
# 走 pycairo 直连的 fallback 编组路径，避免偶发失败。

# Windows HiDPI：用户选择「真原生 1×」——清晰、组件与文字比例正确、但整体偏小。
# GTK4 的 Win32 后端只做整数缩放（150% DPI 被 floor 成 1×），且忽略 GDK_SCALE，所以
# 组件布局固定为 1×。默认情况下文字会按系统 144 DPI 渲染成 1.5×，造成「组件小、文字大」
# 的错位。这里不缩放、不拉伸，仅把文字 DPI 强制降到 96（见下方 gtk-xft-dpi 设置），
# 使文字也回到 1×，与组件对齐。进程保持 GTK 默认的 per-monitor 感知，无 DWM 拉伸、
# 完全清晰。代价：在 150% 屏上整个应用会比桌面其它程序小一圈。

import sys, os.path

if sys.platform == 'darwin' and hasattr(sys, '_MEIPASS'):
    bundle_resources = sys._MEIPASS
    schema_dir = os.path.join(bundle_resources, 'share', 'glib-2.0', 'schemas')
    typelib_dir = os.path.join(bundle_resources, 'lib', 'girepository-1.0')
    if os.path.isdir(schema_dir):
        os.environ.setdefault('GSETTINGS_SCHEMA_DIR', schema_dir)
    if os.path.isdir(typelib_dir):
        os.environ.setdefault('GI_TYPELIB_PATH', typelib_dir)

import cairo
import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk
from gi.repository import Gio
from gi.repository import Adw, GLib

import gettext, argparse, locale

# Windows：把文字 DPI 强制设为 96（gtk-xft-dpi 的单位是 1/1024，故 96*1024），
# 让文字回到 1×，与组件布局的 1× 对齐，消除「组件小、文字大」的错位。进程保持
# GTK 默认 per-monitor 感知，无 DWM 拉伸、清晰；代价是 150% 屏上整体偏小。
if sys.platform == 'win32':
    try:
        Gtk.Settings.get_default().set_property('gtk-xft-dpi', 96 * 1024)
    except Exception:
        pass


def portable_path(configured_path, *relative_parts):
    '''便携版资源路径解析。

    resources_path / app_icons_path / localedir_path 这几个占位符是 meson 在
    构建期按 prefix 写死的绝对路径。Windows 便携 zip 将脚本安装在
    <root>/bin/ 下、资源放在 <root>/share/ 下；macOS 应用包则将资源放在
    打包器提供的资源根目录。两种场景都优先推导相对路径，推导结果不存在时
    （如开发模式）回退到构建期路径。
    '''
    if sys.platform == 'win32':
        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        candidate = os.path.join(root, *relative_parts)
    elif sys.platform == 'darwin' and hasattr(sys, '_MEIPASS'):
        candidate = os.path.join(sys._MEIPASS, *relative_parts)
    else:
        return configured_path
    return candidate if os.path.isdir(candidate) else configured_path


from setzer.workspace.workspace import Workspace
import setzer.workspace.workspace_viewgtk as view
import setzer.keyboard_shortcuts.shortcuts as shortcuts
from setzer.app.service_locator import ServiceLocator
from setzer.dialogs.dialog_locator import DialogLocator
from setzer.dialogs.first_run_tutorial.first_run_tutorial import maybe_show_first_run_tutorial
from setzer.app.color_manager import ColorManager
from setzer.app.font_manager import FontManager
from setzer.popovers.popover_manager import PopoverManager
from setzer.app.latex_db import LaTeXDB
from setzer.settings.document_settings import DocumentSettings
from setzer.helpers.timer import timer

# 尽早安装全局异常处理器，确保后续任何代码抛出的未捕获异常都不会静默崩溃。
# 覆盖：主线程 (sys.excepthook)、非主线程 (threading.excepthook)、GLib 回调。
from setzer.app.exception_handler import install as install_exception_handler
install_exception_handler()


class MainApplicationController(Adw.Application):

    def __init__(self):
        Adw.Application.__init__(self, application_id='org.cvfosammmm.Setzer', flags=Gio.ApplicationFlags.HANDLES_OPEN)

        self.is_active = False

    def do_open(self, files, number_of_files, hint=""):
        if not self.is_active:
            Adw.Application.do_activate(self)

            self.activate()
            self.is_active = True

        # open first session file if any
        for file in files:
            if file.get_path().endswith('.stzs'):
                filename = file.get_path()

                active_document = self.workspace.get_active_document()
                documents = self.workspace.get_all_documents()
                unsaved_documents = self.workspace.get_unsaved_documents()
                dialog = DialogLocator.get_dialog('close_confirmation')
                not_save_to_close_documents = dialog.run(unsaved_documents)['not_save_to_close_documents']

                if len(not_save_to_close_documents) == 0:
                    if documents != None:
                        for document in documents:
                            self.workspace.remove_document(document)
                    self.workspace.load_documents_from_session_file(filename)

        # open latex and bibtex files
        for file in files:
            if file.get_path().endswith('.tex') or file.get_path().endswith('.bib') or file.get_path().endswith('.cls') or file.get_path().endswith('.sty'):
                document_candidate = self.workspace.get_document_by_filename(file.get_path())
                if document_candidate != None:
                    self.workspace.set_active_document(document_candidate)
                else:
                    document_candidate = self.workspace.create_document_from_filename(file.get_path())
                    if document_candidate != None:
                        self.workspace.set_active_document(document_candidate)

    def do_activate(self):
        if not self.is_active:
            Adw.Application.do_activate(self)

            self.activate()
            self.is_active = True

    def do_shutdown(self):
        '''SIGTERM / SIGINT / session manager 退出时的无副作用持久化。

        与用户主动关闭窗口（close-request → save_quit）不同：这里不弹任何对话框，
        静默保存窗口状态和工作区状态，避免退出时阻塞。'''
        try:
            if hasattr(self, 'workspace') and hasattr(self, 'main_window'):
                for document in self.workspace.open_documents:
                    DocumentSettings.save_document_state(document)
                self.workspace.save_to_disk()
                self.save_window_state()
        except Exception:
            pass
        Adw.Application.do_shutdown(self)

    def activate(self):
        # 先读取用户语言偏好，再初始化 gettext，使界面语言选择生效
        self.settings = ServiceLocator.get_settings()
        lang = self.settings.get_value('preferences', 'language') or None
        languages = [lang] if lang else None
        # gettext.install() 不支持 languages 参数，故用 translation() 显式指定
        # 界面语言（优先于系统环境变量 LANG/LANGUAGE），再注入全局 _ / ngettext。
        # 开发模式 localedir 为 /tmp/usr/share/locale；若该处无对应 mo（无论用户
        # 显式选了语言还是仅靠 LANGUAGE 环境变量），回退到系统 locale 路径，使
        # 开发版也能加载已安装的语言包。两种路径都失败再 fallback 到英文原文。
        localedir = portable_path('@localedir_path@', 'share', 'locale')
        try:
            trans = gettext.translation('setzer', localedir, languages=languages)
        except (FileNotFoundError, OSError, IOError):
            # 回退到系统 locale 目录。Linux 用 /usr/share/locale；
            # Windows 无此路径，gettext fallback=True 会直接回退到英文原文。
            fallback_localedir = '/usr/share/locale' if sys.platform != 'win32' else localedir
            trans = gettext.translation('setzer', fallback_localedir, languages=languages, fallback=True)
        import builtins
        builtins._ = trans.gettext
        builtins.ngettext = trans.ngettext

        # 日期/时间显示（GLib.DateTime.format 的 %x/%X）依赖 C 库 LC_TIME。
        # gettext 已按 lang 加载界面译文，但 LC_TIME 默认仍是 C/POSIX，不显式
        # setlocale 则时间戳不会本地化（如德语应为 29.07.2026 而非 2026-07-29）。
        # 仅设置 LC_TIME，避免影响数字格式等其他分类。用户未显式选语言时
        # 用空串 '' 跟随系统环境变量（LANG/LANGUAGE）。locale 未安装则静默跳过。
        try:
            if lang:
                locale.setlocale(locale.LC_TIME, lang)
            else:
                locale.setlocale(locale.LC_TIME, '')
        except locale.Error:
            pass

        # get settings
        self.settings = ServiceLocator.get_settings()
        # 应用主题模式（system/light/dark），默认跟随系统。
        # 注意：不要用 Gtk.Settings 的 gtk-application-prefer-dark-theme
        # 旧属性（libadwaita 已废弃，显式设置反而触发 Adwaita-WARNING），
        # 深浅色统一由 Adw.StyleManager.color-scheme 控制（如下）。
        theme_mode = self.settings.get_value('preferences', 'app_theme_mode')
        if theme_mode == 'light':
            Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_LIGHT)
        elif theme_mode == 'dark':
            Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        else:
            Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.DEFAULT)

        # init static variables
        ServiceLocator.set_setzer_version('@setzer_version@')
        ServiceLocator.set_resources_path(portable_path('@resources_path@', 'share', 'Setzer', 'resources'))
        ServiceLocator.set_app_icons_path(portable_path('@app_icons_path@', 'share', 'icons'))
        resources_path = ServiceLocator.get_resources_path()
        app_icons_path = ServiceLocator.get_app_icons_path()

        # init main window, model, dialogs
        self.main_window = view.MainWindow(self)

        icon_theme = Gtk.IconTheme.get_for_display(self.main_window.get_display())
        search_paths = [
            os.path.join(resources_path, 'icons'),
            app_icons_path,
        ]
        for folder in ['arrows', 'greek_letters', 'misc_math', 'misc_text', 'operators', 'relations']:
            search_paths.append(os.path.join(resources_path, 'symbols', folder))
        for path in dict.fromkeys(search_paths):
            icon_theme.add_search_path(path)

        ServiceLocator.set_main_window(self.main_window)
        ColorManager.init(self.main_window)
        FontManager.init(self.main_window)

        self.workspace = Workspace()

        PopoverManager.init(self.main_window, self.workspace)
        LaTeXDB.init(resources_path)
        self.main_window.create_widgets()
        ServiceLocator.set_workspace(self.workspace)
        DialogLocator.init_dialogs(self.main_window, self.workspace)

        # init view
        if self.settings.get_value('window_state', 'is_maximized'):
            self.main_window.maximize()
        else:
            self.main_window.unmaximize()
        self.main_window.set_default_size(self.settings.get_value('window_state', 'width'),
                                          self.settings.get_value('window_state', 'height'))
        self.main_window.present()

        # 首次启动引导：应用真正首次启动时弹一次（由 settings 标志保证只弹一次）。
        # 放在 present() 之后，确保窗口已可见、作为模态浮于其上。
        maybe_show_first_run_tutorial()

        self.main_window.connect('close-request', self.on_window_close)

        # init controller
        self.workspace.init_workspace_controller()
        self.shortcuts = shortcuts.Shortcuts()
        ServiceLocator.set_shortcuts(self.shortcuts)
        self.workspace.actions.actions['quit'].connect('activate', self.on_quit_action)

        # ① 周期快照：每 30 秒保存工作区布局与每文档状态，避免崩溃/断电丢失布局。
        GLib.timeout_add_seconds(30, self.periodic_snapshot)

    def save_window_state(self):
        main_window = self.main_window
        # 用 surface 实际宽高而非 default-width/default-height：后者是 set_default_size
        # 设置的初始请求大小，用户调整窗口后不会自动更新。surface.get_width()/get_height()
        # 返回的是窗口管理器分配的实际像素尺寸。
        surface = main_window.get_surface()
        if surface is not None:
            self.settings.set_value('window_state', 'width', surface.get_width())
            self.settings.set_value('window_state', 'height', surface.get_height())
        self.settings.set_value('window_state', 'is_maximized', main_window.is_maximized())
        self.settings.set_value('window_state', 'show_help', self.workspace.show_help)
        self.settings.set_value('window_state', 'show_preview', self.workspace.show_preview)
        self.settings.set_value('window_state', 'show_build_log', self.workspace.show_build_log)
        self.settings.set_value('window_state', 'show_symbols', self.workspace.show_symbols)
        self.settings.set_value('window_state', 'show_document_structure', self.workspace.show_document_structure)
        self.settings.set_value('window_state', 'sidebar_width_fraction', main_window.sidebar_split.get_sidebar_width_fraction())
        self.settings.pickle()

    def on_window_close(self, window=None, parameter=None):
        self.save_quit()
        return True

    def on_quit_action(self, action=None, parameter=None):
        self.save_quit()

    def save_quit(self, unsaved_documents=None):
        for document in self.workspace.open_documents: DocumentSettings.save_document_state(document)

        if unsaved_documents == None:
            unsaved_documents = self.workspace.get_unsaved_documents()

        if len(unsaved_documents) > 0:
            self.workspace.set_active_document(unsaved_documents[0])
            dialog = DialogLocator.get_dialog('close_confirmation')
            dialog.run({'unsaved_document': unsaved_documents[0], 'documents': unsaved_documents}, self.save_quit_callback)
        else:
            self.save_state_and_quit()

    def save_quit_callback(self, parameters):
        document = parameters['unsaved_document']
        unsaved_documents = parameters['documents']

        if parameters['response'] == 0:  # discard (单个放弃)
            # 从 workspace 移除该文档，使其不会被写入 workspace.json
            self.workspace.remove_document(document)
            unsaved_documents.remove(document)
            self.save_quit(unsaved_documents)
        elif parameters['response'] == 4:  # discard_all (全部放弃)
            for d in list(unsaved_documents):
                self.workspace.remove_document(d)
                try:
                    unsaved_documents.remove(d)
                except ValueError:
                    pass
            self.save_quit(unsaved_documents)
        elif parameters['response'] == 2:  # save (单个保存)
            document = parameters['unsaved_document']
            if document.get_filename() == None:
                DialogLocator.get_dialog('save_document').run(document, self.save_callback, parameters)
            else:
                document.save_to_disk()
                unsaved_documents.remove(document)
                self.save_quit(unsaved_documents)
        elif parameters['response'] == 3:  # save_all (批量保存)
            unsaved_documents = parameters['documents']
            # 先保存所有有 filename 的文档
            for d in list(unsaved_documents):
                if d.get_filename() is not None:
                    d.save_to_disk()
                    unsaved_documents.remove(d)
            # 无 filename 的逐个弹 save_document
            parameters['save_all_processed'] = set()
            untitled = [d for d in unsaved_documents if d.get_filename() is None]
            if untitled:
                first = untitled[0]
                parameters['save_all_processed'].add(id(first))
                self.workspace.set_active_document(first)
                parameters['unsaved_document'] = first
                DialogLocator.get_dialog('save_document').run(first, self.save_quit_save_all_cb, parameters)
            else:
                self.save_quit(unsaved_documents)

    def save_quit_save_all_cb(self, parameters):
        '''save_all 模式下逐个 untitled 文档的 save_document 回调。'''
        unsaved_documents = parameters['documents']
        processed = parameters.get('save_all_processed', set())
        untitled = [d for d in unsaved_documents
                    if d.get_filename() is None and id(d) not in processed]
        if untitled:
            next_doc = untitled[0]
            processed.add(id(next_doc))
            self.workspace.set_active_document(next_doc)
            parameters['unsaved_document'] = next_doc
            DialogLocator.get_dialog('save_document').run(next_doc, self.save_quit_save_all_cb, parameters)
        else:
            # 所有 untitled 已提示过（保存或取消）。重新评估未保存文档。
            self.save_quit(unsaved_documents)

    def save_callback(self, parameters):
        document = parameters['unsaved_document']
        unsaved_documents = parameters['documents']

        if not document.source_buffer.get_modified():
            unsaved_documents.remove(document)
        self.save_quit(unsaved_documents)

    def save_state_and_quit(self):
        self.save_window_state()
        self.workspace.save_to_disk()
        self.quit()

    def periodic_snapshot(self):
        '''周期快照：保存工作区布局 + 每文档状态，避免崩溃/断电丢失布局。'''
        try:
            self.workspace.save_to_disk()
            for document in self.workspace.open_documents:
                DocumentSettings.save_document_state(document)
        except Exception:
            pass
        return True


argparser = argparse.ArgumentParser(usage='%(prog)s [OPTION...] [FILE...]')
argparser.add_argument('-V', '--version', action='version', version='@setzer_version@')
argparser.add_argument('file', nargs='*', help=argparse.SUPPRESS)
argparser.parse_args()

main_controller = MainApplicationController()
exit_status = main_controller.run(sys.argv)
sys.exit(exit_status)
