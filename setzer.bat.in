@echo off
rem Setzer Windows launcher (generated by meson from setzer.bat.in)
rem Use the python bundled next to this .bat (same mingw64\bin directory) so the
rem packaged app is portable and does not depend on a python installed at a fixed
rem absolute path (e.g. C:\msys64\mingw64\bin). %~dp0 is this .bat's directory.
"%~dp0python.exe" "%~dp0setzer" %*
